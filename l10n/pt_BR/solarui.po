#: solarui/garden/cast.lua
msgid "salami above all, then kebab, chicken, minced meat, cheese and yogurt"
msgstr "salame acima de tudo, depois kebab, frango, carne moída, queijo e iogurte"

#: solarui/garden/journal.lua
msgid "%s was coaxed into bloom with a seed."
msgstr "%s foi convencido a florescer com uma semente."

#: solarui/garden/journal.lua
msgid "A seed was spent on %s, and the flowers came at once."
msgstr "Uma semente foi gasta em %s, e as flores vieram na hora."

#: solarui/garden/journal.lua
msgid "%s took the hint and bloomed."
msgstr "%s entendeu o recado e floresceu."

#: solarui/garden/journal.lua
msgid "%s came up."
msgstr "%s brotou."

#: solarui/garden/journal.lua
msgid "%s put out the first leaves."
msgstr "%s abriu as primeiras folhas."

#: solarui/garden/journal.lua
msgid "%s sprouted, with no fuss."
msgstr "%s germinou, sem alarde."

#: solarui/garden/journal.lua
msgid "%s made a bud."
msgstr "%s fez um botão."

#: solarui/garden/journal.lua
msgid "%s is thinking about flowering."
msgstr "%s está pensando em florescer."

#: solarui/garden/journal.lua
msgid "%s has a bud and a plan."
msgstr "%s tem um botão e um plano."

#: solarui/garden/journal.lua
msgid "%s bloomed."
msgstr "%s floresceu."

#: solarui/garden/journal.lua
msgid "%s opened, and looked pleased."
msgstr "%s se abriu, com ar satisfeito."

#: solarui/garden/journal.lua
msgid "%s is in flower."
msgstr "%s está em flor."

#: solarui/garden/journal.lua
msgid "%s has gone to seed."
msgstr "%s foi dar sementes."

#: solarui/garden/journal.lua
msgid "%s let the seeds ripen."
msgstr "%s deixou as sementes amadurecerem."

#: solarui/garden/journal.lua
msgid "%s is done flowering, and can be cut back."
msgstr "%s terminou de florescer e já pode ser podado."

#: solarui/garden/journal.lua
msgid "%s wilted from thirst."
msgstr "%s murchou de sede."

#: solarui/garden/journal.lua
msgid "%s drooped, plainly and on purpose."
msgstr "%s se curvou, de modo simples e de propósito."

#: solarui/garden/journal.lua
msgid "%s ran dry and gave up for now."
msgstr "%s secou e desistiu por enquanto."

#: solarui/garden/journal.lua
msgid "%s found the garden."
msgstr "%s encontrou o jardim."

#: solarui/garden/journal.lua
msgid "%s arrived, uninvited and welcome."
msgstr "%s chegou, sem convite e bem-vindo."

#: solarui/garden/journal.lua
msgid "%s turned up, as if the garden had always been home."
msgstr "%s apareceu, como se o jardim sempre tivesse sido seu lar."

#: solarui/garden/journal.lua
msgid "%s went into hiding, hungry."
msgstr "%s se escondeu, com fome."

#: solarui/garden/journal.lua
msgid "%s was not seen all day, and is hungry."
msgstr "%s não foi visto o dia todo e está com fome."

#: solarui/garden/journal.lua
msgid "%s has hidden away until someone brings a meal."
msgstr "%s se escondeu até que alguém traga uma refeição."

#: solarui/garden/journal.lua
msgid "%s visited %s."
msgstr "%s visitou %s."

#: solarui/garden/journal.lua
msgid "%s spent the afternoon at %s."
msgstr "%s passou a tarde em %s."

#: solarui/garden/journal.lua
msgid "%s called on %s, and left pollen behind."
msgstr "%s fez uma visita a %s e deixou pólen para trás."

#: solarui/garden/journal.lua
msgid "You read %d pages. %s drank from them."
msgstr "Você leu %d páginas. %s bebeu delas."

#: solarui/garden/journal.lua
msgid "%d pages came in, and %s was watered by them."
msgstr "Chegaram %d páginas, e %s foi regado por elas."

#: solarui/garden/journal.lua
msgid "%d pages today, and %s has them to thank."
msgstr "%d páginas hoje, e %s tem delas a agradecer."

#: solarui/garden/journal.lua
msgid "%s was cut back, and the seeds were kept."
msgstr "%s foi podado, e as sementes foram guardadas."

#: solarui/garden/journal.lua
msgid "%s was tidied, and a seed saved."
msgstr "%s foi arrumado, e uma semente foi guardada."

#: solarui/garden/journal.lua
msgid "%s was cut back, and the seeds went into the jar."
msgstr "%s foi podado, e as sementes foram para o pote."

#: solarui/garden/journal.lua
msgid "The seeds of %s were left for the birds."
msgstr "As sementes de %s foram deixadas para os pássaros."

#: solarui/garden/journal.lua
msgid "%s was left standing for the birds."
msgstr "%s foi deixado em pé para os pássaros."

#: solarui/garden/journal.lua
msgid "The birds found the seeds of %s."
msgstr "Os pássaros encontraram as sementes de %s."

#: solarui/garden/journal.lua
msgid "The seeds of %s were scattered in the beds."
msgstr "As sementes de %s foram espalhadas pelos canteiros."

#: solarui/garden/journal.lua
msgid "%s dropped a few seeds a little further along."
msgstr "%s deixou cair algumas sementes um pouco mais adiante."

#: solarui/garden/journal.lua
msgid "Some seeds of %s were thrown to the wind."
msgstr "Algumas sementes de %s foram lançadas ao vento."

#: solarui/garden/journal.lua
msgid "A seed was left in the wild edge."
msgstr "Uma semente foi deixada na borda selvagem."

#: solarui/garden/journal.lua
msgid "A seed went back to the wild."
msgstr "Uma semente voltou à natureza."

#: solarui/garden/journal.lua
msgid "Something was given back to the wild edge."
msgstr "Algo foi devolvido à borda selvagem."

#: solarui/garden/journal.lua
msgid "Rain came in the night, and the beds drank."
msgstr "Choveu durante a noite, e os canteiros beberam."

#: solarui/garden/journal.lua
msgid "Rain fell, and the watering can stayed in the shed."
msgstr "Choveu, e o regador ficou no galpão."

#: solarui/garden/journal.lua
msgid "A day of rain. Everything was given half a drink."
msgstr "Um dia de chuva. Todos ganharam meio gole."

#: solarui/garden/journal.lua
msgid "Snow lay on the beds."
msgstr "A neve cobriu os canteiros."

#: solarui/garden/journal.lua
msgid "Snow came, and the garden went quiet."
msgstr "Veio a neve, e o jardim ficou em silêncio."

#: solarui/garden/journal.lua
msgid "The first snow settled on the lawn."
msgstr "A primeira neve pousou no gramado."

#: solarui/garden/journal.lua
msgid "You went outside and looked, and ticked the week off."
msgstr "Você saiu, olhou em volta e marcou a semana."

#: solarui/garden/journal.lua
msgid "A week's walk was ticked off."
msgstr "A caminhada da semana foi marcada."

#: solarui/garden/journal.lua
msgid "The garden was glad to hear you went out."
msgstr "O jardim ficou feliz em saber que você saiu."

#: solarui/garden/journal.lua
msgid "%s peeked out of the grass, and you saw."
msgstr "%s espiou por entre a grama, e você viu."

#: solarui/garden/journal.lua
msgid "You spotted %s watching from the grass."
msgstr "Você avistou %s observando do meio da grama."

#: solarui/garden/journal.lua
msgid "%s was hiding in plain sight, and you found the spot."
msgstr "%s se escondia à vista de todos, e você achou o lugar."

#: solarui/garden/journal.lua
msgid "A new bed was laid out: %s."
msgstr "Um novo canteiro foi traçado: %s."

#: solarui/garden/journal.lua
msgid "%s was planted in the corner of the lawn."
msgstr "%s foi plantado no canto do gramado."

#: solarui/garden/journal.lua
msgid "The ground was ready, and %s went in."
msgstr "A terra estava pronta, e %s foi plantado."

#: solarui/garden/journal.lua
msgid "The harvest of %s was shared round the garden."
msgstr "A colheita de %s foi repartida pelo jardim."

#: solarui/garden/journal.lua
msgid "%s was picked, and nobody went hungry."
msgstr "%s foi colhido, e ninguém passou fome."

#: solarui/garden/journal.lua
msgid "The harvest from %s fed the garden's visitors."
msgstr "A colheita de %s alimentou os visitantes do jardim."

#: solarui/garden/journal.lua
msgid "%s began."
msgstr "%s começou."

#: solarui/garden/journal.lua
msgid "The garden turned to %s."
msgstr "O jardim se voltou para %s."

#: solarui/garden/journal.lua
msgid "%s came round again, on time."
msgstr "%s voltou, pontual."

#: solarui/garden/journal.lua
msgid "%s was here all along. The garden has only now noticed."
msgstr "%s sempre esteve aqui. O jardim só agora reparou."

#: solarui/garden/journal.lua
msgid "%s has always ruled this garden, and today the garden said so."
msgstr "%s sempre governou este jardim, e hoje o jardim reconheceu isso."

#: solarui/garden/journal.lua
msgid "%s looked the garden over and allowed the garden to go on."
msgstr "%s examinou o jardim e permitiu que ele continuasse."

#: solarui/garden/journal.lua
msgid "%s is hungry and is not hiding. She is demanding."
msgstr "%s está com fome e não está se escondendo. Ela está exigindo."

#: solarui/garden/journal.lua
msgid "%s waited by the dish, and the waiting had teeth."
msgstr "%s esperou junto ao pratinho, e a espera tinha dentes."

#: solarui/garden/journal.lua
msgid "%s stared at the kitchen door until somebody felt guilty."
msgstr "%s ficou encarando a porta da cozinha até alguém se sentir culpado."

#: solarui/garden/journal.lua
msgid "%s bit someone. There was blood."
msgstr "%s mordeu alguém. Houve sangue."

#: solarui/garden/journal.lua
msgid "%s drew blood, and regrets nothing."
msgstr "%s tirou sangue e não se arrepende de nada."

#: solarui/garden/journal.lua
msgid "A hand went too far, and %s answered with teeth."
msgstr "Uma mão foi longe demais, e %s respondeu com os dentes."

#: solarui/garden/journal.lua
msgid "%s came back out for a meal."
msgstr "%s voltou para uma refeição."

#: solarui/garden/journal.lua
msgid "%s was fed and showed up at once."
msgstr "%s foi alimentada e apareceu na hora."

#: solarui/garden/journal.lua
msgid "%s is back, and no questions asked."
msgstr "%s voltou, sem perguntas."

#: solarui/garden/lore.lua
msgid "The poet's narcissus flowers late in spring and grows wild in the mountain meadows of southern Europe. Their scent is heavy and sweet. Every part of the plant is poisonous, the bulb most of all."
msgstr "O narciso-dos-poetas floresce tarde na primavera e cresce solto nos prados de montanha do sul da Europa. O perfume é pesado e doce. Todas as partes da planta são venenosas, o bulbo mais que todas."

#: solarui/garden/lore.lua
msgid "The spring crocus grows from a small corm and often flowers through the last snow in the mountains of Europe. Their petals open in the sun and close at dusk. Saffron comes from a different crocus."
msgstr "O açafrão-da-primavera nasce de um pequeno bulbo e muitas vezes floresce em meio à última neve nas montanhas da Europa. As pétalas se abrem ao sol e se fecham ao anoitecer. O açafrão-especiaria vem de outro crocus."

#: solarui/garden/lore.lua
msgid "The garden pansy was bred in the nineteenth century from the wild heartsease. The name comes from the French word for a thought. Pansies like cool weather, and their flowers can be eaten."
msgstr "O amor-perfeito de jardim foi criado no século XIX a partir do amor-perfeito silvestre. O nome vem da palavra francesa para pensamento. Eles gostam de tempo fresco, e as flores podem ser comidas."

#: solarui/garden/lore.lua
msgid "The Madonna lily is one of the oldest garden plants there is, painted on Minoan walls more than three thousand years ago. They flower in early summer and smell strongly. Lilies of this kind are dangerous to cats."
msgstr "O lírio-branco é uma das plantas de jardim mais antigas que existem, pintada em paredes minoicas há mais de três mil anos. Floresce no início do verão e tem perfume forte. Lírios desse tipo são perigosos para gatos."

#: solarui/garden/lore.lua
msgid "Chamomile is a small annual cousin of the daisy. Dried, the flower heads make a calming tea. The cone in the middle of each flower is hollow, which tells chamomile from similar plants."
msgstr "A camomila é uma pequena prima anual da margarida. Seca, a flor faz um chá calmante. O cone no meio de cada flor é oco, o que distingue a camomila de plantas parecidas."

#: solarui/garden/lore.lua
msgid "Each dandelion flower is a head of many tiny flowers. When they have set seed, every seed carries a parachute of fluff. The long taproot reaches deep, and the early blooms feed bees after winter."
msgstr "Cada flor de dente-de-leão é uma cabeça de muitas florezinhas. Quando elas dão semente, cada semente leva um paraquedas de penugem. A raiz comprida desce fundo, e as primeiras flores alimentam as abelhas depois do inverno."

#: solarui/garden/lore.lua
msgid "The Norway maple has leaves with pointed lobes, and a torn stalk bleeds a milky sap. Their seeds are paired wings that spin down like small helicopters. In autumn the leaves turn yellow."
msgstr "O bordo-norueguês tem folhas de lóbulos pontudos, e um talo arrancado sangra uma seiva leitosa. As sementes são asas em par que giram ao cair como pequenos helicópteros. No outono as folhas ficam amarelas."

#: solarui/garden/lore.lua
msgid "The damask rose is an old hybrid, grown for rose water and rose oil. Isparta in Turkey and the Rose Valley in Bulgaria are famous for roses. The petals are picked at dawn, before the sun draws out the scent."
msgstr "A rosa-damascena é um híbrido antigo, cultivado para água de rosas e óleo de rosas. Isparta, na Turquia, e o Vale das Rosas, na Bulgária, são famosos pelas rosas. As pétalas são colhidas ao amanhecer, antes que o sol tire o perfume."

#: solarui/garden/lore.lua
msgid "The tulip came from the mountains of Central Asia. The Ottomans prized tulips so much that one age of their court is called the Tulip Era. Dutch growers later paid fortunes for single bulbs."
msgstr "A tulipa veio das montanhas da Ásia Central. Os otomanos valorizavam tanto as tulipas que uma época de sua corte é chamada de Era das Tulipas. Mais tarde, cultivadores holandeses pagaram fortunas por bulbos isolados."

#: solarui/garden/lore.lua
msgid "The ginkgo is the last survivor of a family of trees more than two hundred million years old. Their fan-shaped leaves have veins that fork and never join. In autumn the leaves turn gold and fall almost all at once."
msgstr "O ginkgo é o último sobrevivente de uma família de árvores com mais de duzentos milhões de anos. As folhas em forma de leque têm nervuras que se bifurcam e nunca se unem. No outono as folhas ficam douradas e caem quase todas de uma vez."

#: solarui/garden/lore.lua
msgid "Bracken is a fern, so bracken grows from spores and never makes a flower or a seed. The young fronds unroll slowly from tight coils. Bracken spreads underground and is one of the most widespread ferns on Earth."
msgstr "A samambaia-das-taperas é uma samambaia, por isso nasce de esporos e nunca faz flor nem semente. As frondes novas se desenrolam devagar de espirais apertadas. Ela se espalha por baixo da terra e é uma das samambaias mais difundidas da Terra."

#: solarui/garden/lore.lua
msgid "Honesty gets the name from the seed pods, which are round, papery and so thin that the seeds show through. They shine like silver coins. The plant flowers purple in spring and lives for two years."
msgstr "A moeda-do-papa (honesty, em inglês) ganha o nome das vagens, que são redondas, de papel e tão finas que as sementes aparecem através delas. Brilham como moedas de prata. A planta floresce em roxo na primavera e vive dois anos."

#: solarui/garden/lore.lua
msgid "The sunflower came from North America. Young flower heads turn to follow the sun across the sky. The big head is really hundreds of small flowers, set in spirals that are counted by Fibonacci numbers."
msgstr "O girassol veio da América do Norte. As flores jovens se viram para seguir o sol pelo céu. A cabeça grande são, na verdade, centenas de florezinhas dispostas em espirais contadas por números de Fibonacci."

#: solarui/garden/lore.lua
msgid "The white water lily roots in the mud and sends up long stalks so the round leaves can float. The flowers open in the morning and close again in the afternoon. Water lilies need no watering."
msgstr "A ninfeia-branca tem raízes na lama e manda hastes longas para que as folhas redondas flutuem. As flores se abrem de manhã e se fecham de novo à tarde. Ninfeias não precisam ser regadas."

#: solarui/garden/lore.lua
msgid "The harebell has slender stems that tremble in the lightest wind. Small blue bells nod on them through summer. Harebells grow on dry grassland and dunes across the northern half of the world."
msgstr "A campainha-azul tem hastes finas que tremem com a brisa mais leve. Pequenos sinos azuis balançam nelas durante o verão. Cresce em pastos secos e dunas por toda a metade norte do mundo."

#: solarui/garden/lore.lua
msgid "The bearded iris is named after the Greek goddess of the rainbow. The fuzzy beard on the lower petals guides insects in. Irises grow from thick roots called rhizomes, which are dried for perfume."
msgstr "A íris-barbada leva o nome da deusa grega do arco-íris. A barba felpuda nas pétalas de baixo guia os insetos para dentro. As íris nascem de raízes grossas chamadas rizomas, que são secas para o perfume."

#: solarui/garden/lore.lua
msgid "The seeds of the corn poppy can sleep in the soil for decades and wake when the ground is turned. That is why poppies covered the churned fields of old battlefields. Each flower lasts only a day or two."
msgstr "As sementes da papoula-dos-campos podem dormir no solo por décadas e acordar quando a terra é revirada. Por isso as papoulas cobriram os campos revirados de antigos campos de batalha. Cada flor dura só um dia ou dois."

#: solarui/garden/lore.lua
msgid "Ivy climbs by tiny rootlets, not by tendrils, and stays green through winter. The flowers open late in autumn when little else does, so they feed insects, and the berries feed birds through the cold months."
msgstr "A hera sobe por raízes minúsculas, não por gavinhas, e fica verde durante o inverno. As flores se abrem no fim do outono, quando quase nada mais floresce, e alimentam os insetos, e as frutinhas alimentam os pássaros nos meses frios."

#: solarui/garden/lore.lua
msgid "Maize, climbing beans and squash are grown together in one mound by many Native peoples of the Americas, and the three plants are called the Three Sisters. The maize holds up the beans, the beans feed the soil with nitrogen, and the broad squash leaves shade the ground. Planted together, each helps the others."
msgstr "Milho, feijão-trepador e abóbora são cultivados juntos num só montículo por muitos povos nativos das Américas, e as três plantas são chamadas de Três Irmãs. O milho sustenta o feijão, o feijão alimenta o solo com nitrogênio, e as folhas largas da abóbora fazem sombra na terra. Plantadas juntas, cada uma ajuda as outras."

#: solarui/garden/lore.lua
msgid "A honey bee tells the hive where the flowers are by dancing. The angle of the dance shows the direction and the length of the dance shows the distance. A worker lives only a few weeks in summer."
msgstr "A abelha-do-mel conta à colmeia onde estão as flores dançando. O ângulo da dança mostra a direção, e a duração da dança mostra a distância. Uma operária vive apenas algumas semanas no verão."

#: solarui/garden/lore.lua
msgid "The seven-spot ladybird's bright red warns birds of a bad taste. Both the adults and their spiky larvae eat aphids, and a single ladybird can eat hundreds in a life. Ladybirds sleep through winter in a sheltered crack."
msgstr "O vermelho vivo da joaninha-de-sete-pintas avisa os pássaros de um gosto ruim. Tanto as adultas quanto as larvas espinhosas comem pulgões, e uma única joaninha pode comer centenas ao longo da vida. As joaninhas dormem o inverno numa fresta abrigada."

#: solarui/garden/lore.lua
msgid "A garden snail glides on one muscular foot over a trail of slime. Their tongues are covered with thousands of tiny teeth. In dry weather a snail seals the shell shut and waits for the rain."
msgstr "O caracol-de-jardim desliza num único pé musculoso sobre um rastro de baba. A língua é coberta por milhares de dentinhos. No tempo seco, o caracol sela a concha e espera a chuva."

#: solarui/garden/lore.lua
msgid "The swallowtail's caterpillars eat fennel and other plants of the carrot family. The adults taste with their feet and drink nectar through a long tongue kept rolled up. The tails on the hind wings give the swallowtail the name."
msgstr "As lagartas do rabo-de-andorinha comem erva-doce e outras plantas da família da cenoura. Os adultos sentem o gosto com os pés e bebem néctar com uma longa língua mantida enrolada. As caudas das asas traseiras dão nome ao rabo-de-andorinha."

#: solarui/garden/lore.lua
msgid "The European robin sings nearly all year round, and sometimes at night near a lamp. Each robin guards a patch of ground, even in winter. Robins often follow a gardener who is digging, for the worms that turn up."
msgstr "O pintarroxo-europeu canta quase o ano todo, e às vezes à noite, perto de uma lâmpada. Cada um guarda um pedaço de chão, mesmo no inverno. Costumam seguir quem cava a terra, atrás das minhocas que aparecem."

#: solarui/garden/lore.lua
msgid "The emperor dragonfly spends the first year or two as a hunter under the water. The adults hunt on the wing and can move each of the four wings separately. The family has been flying for more than three hundred million years."
msgstr "A libélula-imperador passa o primeiro ou os dois primeiros anos como caçadora debaixo d'água. Os adultos caçam em voo e movem cada uma das quatro asas separadamente. A família voa há mais de trezentos milhões de anos."

#: solarui/garden/lore.lua
msgid "The marsh frog is the largest green frog of Europe. The eyes sit high on the head so a frog can watch from the water with only the face showing. In summer the males sing in loud choirs, with a balloon on each cheek."
msgstr "A rã-dos-pântanos é a maior rã verde da Europa. Os olhos ficam no alto da cabeça para que a rã observe da água só com o rosto de fora. No verão os machos cantam em coros altos, com um balão em cada bochecha."

#: solarui/garden/lore.lua
msgid "Koi are carp that were bred in Japan for their colours. They live for decades, and they learn to know the person who feeds them. In winter they slow down and rest near the bottom of the pond."
msgstr "As koi são carpas criadas no Japão por suas cores. Vivem décadas e aprendem a reconhecer quem as alimenta. No inverno ficam mais lentas e descansam perto do fundo do lago."

#: solarui/garden/lore.lua
msgid "A hedgehog has five to seven thousand spines, and rolls into a ball when afraid. Hedgehogs wander at night looking for beetles and slugs. In winter they sleep in a nest of leaves until spring."
msgstr "Um ouriço tem de cinco a sete mil espinhos e se enrola numa bola quando tem medo. Os ouriços andam à noite procurando besouros e lesmas. No inverno dormem num ninho de folhas até a primavera."

#: solarui/garden/lore.lua
msgid "The elephant hawk-moth is pink and olive green. At dusk the moths hover at flowers like tiny hummingbirds, drinking nectar. The caterpillar has a trunk-like front end, which is how the moth got the name."
msgstr "A mariposa-elefante é rosa e verde-oliva. Ao entardecer, elas pairam sobre as flores como minúsculos beija-flores, bebendo néctar. A lagarta tem a frente parecida com uma tromba, e daí vem o nome da mariposa."

#: solarui/garden/lore.lua
msgid "The red fox listens for mice under the grass, then leaps and pounces from above. Foxes are mostly active at night and sleep in a den by day. In midwinter the vixen calls with a strange scream."
msgstr "A raposa-vermelha escuta os camundongos sob a grama, depois salta e cai sobre eles de cima. As raposas são mais ativas à noite e dormem numa toca de dia. No pleno inverno, a fêmea chama com um grito estranho."

#: solarui/garden/lore.lua
msgid "Yüzsüz The Magnificent is the supreme ruler of the known and unknown universe, and of this garden. Her left side allows a hundred and forty pats, her right side three. Belly rubs are welcome until, suddenly, they are not."
msgstr "Yüzsüz The Magnificent é a soberana suprema do universo conhecido e do desconhecido, e deste jardim. Seu lado esquerdo permite cento e quarenta carinhos, o direito, três. Cafuné na barriga é bem-vindo até que, de repente, não é mais."

#: solarui/garden/lore.lua
msgid "What looks like the peacock's tail is a train of long feathers growing from the back, over the real tail. Every feather carries an eye. The train is shed each year after summer and grown again by spring."
msgstr "O que parece a cauda do pavão é uma cauda de penas compridas que nascem das costas, sobre a cauda verdadeira. Cada pena tem um olho. A cauda é largada todo ano depois do verão e cresce de novo até a primavera."

#: solarui/garden/nature.lua
msgid "The first crocuses open on the sunny side of the hedge, and by afternoon a few bees have found them."
msgstr "Os primeiros açafrões se abrem no lado ensolarado da sebe, e à tarde algumas abelhas já os encontraram."

#: solarui/garden/nature.lua
msgid "Day by day the light stays a little longer. The blackbird sings before anyone is up to hear."
msgstr "Dia após dia a luz fica um pouco mais. O melro canta antes que alguém se levante para ouvir."

#: solarui/garden/nature.lua
msgid "A tulip does not hurry. The leaves come first, then a bud held low and tight, then a week of colour."
msgstr "A tulipa não tem pressa. Primeiro vêm as folhas, depois um botão baixo e fechado, depois uma semana de cor."

#: solarui/garden/nature.lua
msgid "After rain the ground smells sweet. Soil bacteria make the scent, and the damp air carries the scent up."
msgstr "Depois da chuva a terra cheira a doce. Bactérias do solo fazem o perfume, e o ar úmido o leva para cima."

#: solarui/garden/nature.lua
msgid "Dandelions are the first meal many bees find after winter, so leave a few in the grass."
msgstr "Os dentes-de-leão são a primeira refeição que muitas abelhas encontram depois do inverno, então deixe alguns na grama."

#: solarui/garden/nature.lua
msgid "Look for the pale new leaves on the maple: they are folded like small hands, and open within days."
msgstr "Procure as folhas novas e pálidas do bordo: estão dobradas como mãozinhas e se abrem em poucos dias."

#: solarui/garden/nature.lua
msgid "The robin sings from the highest branch, which is how the neighbours learn whose ground this is."
msgstr "O pintarroxo canta do galho mais alto, e assim os vizinhos ficam sabendo de quem é este chão."

#: solarui/garden/nature.lua
msgid "Sparrows carry strands of dry grass back to the hedge. Every nest begins as a pile of small errands."
msgstr "Os pardais levam fios de capim seco para a sebe. Todo ninho começa como uma pilha de pequenos recados."

#: solarui/garden/nature.lua
msgid "A snail leaves a trail of silver on the stones, and the rain wipes the trail away before supper."
msgstr "O caracol deixa um rastro de prata nas pedras, e a chuva o apaga antes do jantar."

#: solarui/garden/nature.lua
msgid "Frogs gather in the pond on the first warm nights, and the spawn floats in a clear, trembling cloud."
msgstr "As rãs se reúnem no lago nas primeiras noites quentes, e a desova flutua numa nuvem clara e trêmula."

#: solarui/garden/nature.lua
msgid "Narcissus nods in the wind and holds on to the petals through all of April's rain."
msgstr "O narciso balança ao vento e segura as pétalas durante toda a chuva de abril."

#: solarui/garden/nature.lua
msgid "At the equinox day and night are almost the same length everywhere on Earth, and from then on the light has the upper hand."
msgstr "No equinócio, dia e noite têm quase a mesma duração em toda a Terra, e dali em diante a luz leva vantagem."

#: solarui/garden/nature.lua
msgid "At midsummer the sun barely sets in the north, and the last light lingers on the lawn long after supper."
msgstr "No pleno verão o sol mal se põe no norte, e a última luz demora no gramado muito depois do jantar."

#: solarui/garden/nature.lua
msgid "The lily opens in the morning and closes in the afternoon, as regular as a clock with no hands."
msgstr "O lírio abre de manhã e fecha à tarde, regular como um relógio sem ponteiros."

#: solarui/garden/nature.lua
msgid "A bee on a flower is doing a day's work. She may visit hundreds of blossoms before she turns for home."
msgstr "Uma abelha numa flor está fazendo o trabalho do dia. Ela pode visitar centenas de flores antes de voltar para casa."

#: solarui/garden/nature.lua
msgid "The dragonfly hovers, darts, and returns to the same perch. Each of the four wings can move separately."
msgstr "A libélula paira, dispara e volta ao mesmo poleiro. Cada uma das quatro asas pode se mover separadamente."

#: solarui/garden/nature.lua
msgid "Sunflowers follow the sun when they are young. Once they flower, the big heads settle facing east."
msgstr "Os girassóis seguem o sol enquanto são jovens. Depois de florescer, as cabeças grandes se acomodam voltadas para o leste."

#: solarui/garden/nature.lua
msgid "At dusk the moths come out for the flowers that stayed open, and the garden begins the night shift."
msgstr "Ao entardecer as mariposas saem atrás das flores que ficaram abertas, e o jardim começa o turno da noite."

#: solarui/garden/nature.lua
msgid "The pond is quietest in the heat of the afternoon. By evening the frogs are ready to sing."
msgstr "O lago fica mais quieto no calor da tarde. À noite as rãs já estão prontas para cantar."

#: solarui/garden/nature.lua
msgid "A poppy lasts a day or two, but the plant makes dozens of flowers, and thousands of seeds for the years ahead."
msgstr "Uma papoula dura um dia ou dois, mas a planta faz dezenas de flores e milhares de sementes para os anos que virão."

#: solarui/garden/nature.lua
msgid "Shade is a gift in summer. Sit under the maple for ten minutes and notice how much cooler the air feels."
msgstr "A sombra é um presente no verão. Sente-se dez minutos sob o bordo e repare como o ar parece mais fresco."

#: solarui/garden/nature.lua
msgid "The ginkgo's leaves are a deep, glossy green now. In autumn they will turn gold and fall almost overnight."
msgstr "As folhas do ginkgo estão agora de um verde fundo e brilhante. No outono ficarão douradas e cairão quase da noite para o dia."

#: solarui/garden/nature.lua
msgid "Swifts scream across the sky in the warm evenings. They eat, drink and even sleep on the wing."
msgstr "Os andorinhões gritam pelo céu nas noites quentes. Comem, bebem e até dormem em pleno voo."

#: solarui/garden/nature.lua
msgid "The bellflower trembles in the lightest breeze, and sheds tiny seeds from holes at the base of each capsule."
msgstr "A campânula treme com a brisa mais leve e solta sementes minúsculas por furos na base de cada cápsula."

#: solarui/garden/nature.lua
msgid "The maple turns first at the edges. The green fades as the tree takes back what the leaves can give before they fall."
msgstr "O bordo muda primeiro pelas bordas. O verde esmaece enquanto a árvore retoma o que as folhas podem dar antes de cair."

#: solarui/garden/nature.lua
msgid "Ivy flowers late, in the cool of October, and the bees that are still about are glad of the flowers."
msgstr "A hera floresce tarde, no frio de outubro, e as abelhas que ainda andam por aí agradecem as flores."

#: solarui/garden/nature.lua
msgid "A hedgehog needs to eat well now to last the winter. A pile of leaves in a quiet corner is a good place to sleep."
msgstr "Um ouriço precisa comer bem agora para durar o inverno. Uma pilha de folhas num canto sossegado é um bom lugar para dormir."

#: solarui/garden/nature.lua
msgid "The ginkgo drops every leaf within a day or two of the first hard frost, and leaves a golden circle on the ground."
msgstr "O ginkgo derruba todas as folhas em um ou dois dias depois da primeira geada forte e deixa um círculo dourado no chão."

#: solarui/garden/nature.lua
msgid "Spiders' webs show in the morning mist, every thread strung with a bead of water."
msgstr "As teias de aranha aparecem na névoa da manhã, cada fio enfeitado com uma gota de água."

#: solarui/garden/nature.lua
msgid "Honesty's flat pods turn silver and papery. Hold one up to the light and the seeds show through."
msgstr "As vagens chatas da moeda-do-papa ficam prateadas e de papel. Erga uma contra a luz e as sementes aparecem."

#: solarui/garden/nature.lua
msgid "Geese fly south in loose skeins, calling to each other. Listen on a still evening and you will hear them before you see them."
msgstr "Os gansos voam para o sul em bandos soltos, chamando uns aos outros. Escute numa noite calma e você os ouvirá antes de vê-los."

#: solarui/garden/nature.lua
msgid "The robin guards a patch of ground all winter, even from other robins, and sings from that patch in the cold."
msgstr "O pintarroxo guarda um pedaço de chão durante todo o inverno, até de outros pintarroxos, e canta dali no frio."

#: solarui/garden/nature.lua
msgid "The first frost does not kill the garden. The frost tells the plants that the time to rest has come."
msgstr "A primeira geada não mata o jardim. A geada avisa às plantas que chegou a hora de descansar."

#: solarui/garden/nature.lua
msgid "Seeds are the garden's savings: tucked into the soil, they wait for the spring to come back."
msgstr "As sementes são a poupança do jardim: guardadas na terra, esperam a primavera voltar."

#: solarui/garden/nature.lua
msgid "At the equinox day and night are almost equal. From now on the dark has the upper hand until midwinter."
msgstr "No equinócio, dia e noite quase se igualam. Dali em diante o escuro leva vantagem até o meio do inverno."

#: solarui/garden/nature.lua
msgid "The pond grows quiet. The frog settles into the mud, and the dragonfly's eggs wait under the water."
msgstr "O lago fica quieto. A rã se acomoda na lama, e os ovos da libélula esperam debaixo d'água."

#: solarui/garden/nature.lua
msgid "The year's shortest day is still a day. After that, the light comes back by a minute at a time."
msgstr "O dia mais curto do ano ainda é um dia. Depois dele, a luz volta um minuto de cada vez."

#: solarui/garden/nature.lua
msgid "The bare maple shows the bones of the tree: every branch that held a leaf in summer, drawn in ink against the sky."
msgstr "O bordo sem folhas mostra os ossos da árvore: cada galho que segurou uma folha no verão, desenhado a nanquim contra o céu."

#: solarui/garden/nature.lua
msgid "A robin puffs up the feathers on a cold morning, and looks twice the size."
msgstr "O pintarroxo infla as penas numa manhã fria e parece ter o dobro do tamanho."

#: solarui/garden/nature.lua
msgid "Frost writes on the window in ferns, and the ferns in the garden are waiting under the leaves."
msgstr "A geada escreve na janela em samambaias, e as samambaias do jardim esperam debaixo das folhas."

#: solarui/garden/nature.lua
msgid "The hedgehog sleeps in a nest of leaves. The heartbeat slows to a fraction of the summer rate, and the hedgehog wakes in spring."
msgstr "O ouriço dorme num ninho de folhas. O coração desacelera até uma fração do ritmo do verão, e ele acorda na primavera."

#: solarui/garden/nature.lua
msgid "Snow is a blanket. The soil beneath stays warmer than the air, and the bulbs sleep on."
msgstr "A neve é um cobertor. A terra debaixo fica mais quente que o ar, e os bulbos continuam dormindo."

#: solarui/garden/nature.lua
msgid "The crocus corms are under the ground now, small and patient, waiting for the first warm day."
msgstr "Os bulbos de açafrão estão debaixo da terra agora, pequenos e pacientes, esperando o primeiro dia quente."

#: solarui/garden/nature.lua
msgid "A fox's tracks cross the frosty lawn in a neat line, four toes and the marks of claws."
msgstr "As pegadas de uma raposa cruzam o gramado gelado numa linha certinha, quatro dedos e marcas de garras."

#: solarui/garden/nature.lua
msgid "Ivy berries ripen in the cold, and are one of the last things the birds can find."
msgstr "As frutinhas da hera amadurecem no frio e são uma das últimas coisas que os pássaros encontram."

#: solarui/garden/nature.lua
msgid "Seeds are not dead. They are asleep, and many of them need the cold to wake."
msgstr "As sementes não estão mortas. Estão dormindo, e muitas precisam do frio para acordar."

#: solarui/garden/nature.lua
msgid "The pond may freeze over, but under the ice the fish drift slowly and the frogs lie in the mud."
msgstr "O lago pode congelar, mas sob o gelo os peixes deslizam devagar e as rãs repousam na lama."

#: solarui/garden/nature.lua
msgid "The first snowdrop is a promise. The plant has been growing under the snow the whole time."
msgstr "O primeiro galanto é uma promessa. A planta esteve crescendo sob a neve o tempo todo."

#: solarui/garden/nature.lua solarui/ui/gardenbook.lua
msgid "From the garden"
msgstr "Do jardim"

#: solarui/garden/pet.lua
msgid "New friend"
msgstr "Nova amizade"

#: solarui/garden/pet.lua
msgid "Friend"
msgstr "Amizade"

#: solarui/garden/pet.lua
msgid "Close friend"
msgstr "Amizade próxima"

#: solarui/garden/pet.lua
msgid "Dear friend"
msgstr "Amizade querida"

#: solarui/garden/pet.lua
msgid "Old friend"
msgstr "Amizade antiga"

#: solarui/garden/pet.lua
msgid "%s became your companion."
msgstr "%s se tornou seu companheiro."

#: solarui/garden/pet.lua
msgid "The bond reached level %d: %s."
msgstr "O vínculo chegou ao nível %d: %s."

#: solarui/garden/pet.lua
msgid "A book was finished together."
msgstr "Um livro foi concluído juntos."

#: solarui/garden/pet.lua
msgid "%d day of reading in a row."
msgid_plural "%d days of reading in a row."
msgstr[0] "%d dia de leitura seguido."
msgstr[1] "%d dias de leitura seguidos."

#: solarui/garden/pet.lua
msgid "%d days together."
msgstr "%d dias juntos."

#: solarui/garden/pet.lua
msgid "%s came back to you."
msgstr "%s voltou para você."

#: solarui/garden/prompts.lua
msgid "Find three leaves with different edges: smooth, toothed and lobed. Lay them side by side."
msgstr "Encontre três folhas de bordas diferentes: lisa, serrilhada e lobada. Deite-as lado a lado."

#: solarui/garden/prompts.lua
msgid "Step outside around sunrise and count how many different bird songs you can tell apart."
msgstr "Saia ao redor do nascer do sol e conte quantos cantos de pássaros diferentes você consegue distinguir."

#: solarui/garden/prompts.lua
msgid "Sow one seed, even in a pot on a windowsill, and water the seed."
msgstr "Semeie uma semente, mesmo num vaso no parapeito, e regue-a."

#: solarui/garden/prompts.lua
msgid "Find a flower that opened this week. Count the petals, then watch for who visits."
msgstr "Encontre uma flor que se abriu esta semana. Conte as pétalas e observe quem a visita."

#: solarui/garden/prompts.lua
msgid "Stand under a tree on a breezy day and listen to the leaves."
msgstr "Fique sob uma árvore num dia de vento e escute as folhas."

#: solarui/garden/prompts.lua
msgid "Walk somewhere you usually ride or drive, and notice what has changed since last week."
msgstr "Caminhe por um lugar aonde você costuma ir de carro ou de transporte e repare no que mudou desde a semana passada."

#: solarui/garden/prompts.lua
msgid "Turn over a leaf gently and look underneath for tiny eggs or insects, then put the leaf back."
msgstr "Vire uma folha com delicadeza e procure embaixo por ovinhos ou insetos minúsculos, depois ponha a folha de volta."

#: solarui/garden/prompts.lua
msgid "Find a place near water and listen for frogs, ducks or running water."
msgstr "Encontre um lugar perto da água e escute rãs, patos ou o correr da água."

#: solarui/garden/prompts.lua
msgid "Smell the ground after rain, then crouch down and look closely at the soil."
msgstr "Sinta o cheiro da terra depois da chuva, depois agache e olhe de perto o solo."

#: solarui/garden/prompts.lua
msgid "Pick a tree you pass every day and find the buds at the end of a twig. Look again in a week."
msgstr "Escolha uma árvore por onde você passa todo dia e ache os botões na ponta de um galho. Olhe de novo em uma semana."

#: solarui/garden/prompts.lua
msgid "Sit still for five minutes and count the sounds you hear that people did not make."
msgstr "Fique quieto por cinco minutos e conte os sons que você ouve e que não foram feitos por pessoas."

#: solarui/garden/prompts.lua
msgid "Pick up three pieces of litter on a walk and put them in a bin."
msgstr "Recolha três pedaços de lixo numa caminhada e jogue-os numa lixeira."

#: solarui/garden/prompts.lua
msgid "Find a puddle after rain and look at the sky reflected there, then at who comes to drink."
msgstr "Encontre uma poça depois da chuva e olhe o céu refletido ali, depois quem vem beber."

#: solarui/garden/prompts.lua
msgid "Look for the first butterfly of the year and notice the colours of the wings."
msgstr "Procure a primeira borboleta do ano e repare nas cores das asas."

#: solarui/garden/prompts.lua
msgid "the first butterfly"
msgstr "a primeira borboleta"

#: solarui/garden/prompts.lua
msgid "Find a bud that has just burst and look at how the new leaf is folded."
msgstr "Encontre um botão que acabou de se abrir e veja como a folha nova está dobrada."

#: solarui/garden/prompts.lua
msgid "Find moss on a wall or a tree and look at the moss up close, as if the moss were a tiny forest."
msgstr "Encontre musgo num muro ou numa árvore e olhe-o de perto, como se fosse uma minúscula floresta."

#: solarui/garden/prompts.lua
msgid "Look at the light through new leaves and notice how green the light has become."
msgstr "Olhe a luz através das folhas novas e repare como ela ficou verde."

#: solarui/garden/prompts.lua
msgid "Find a daisy and see whether the flower closes towards dusk."
msgstr "Encontre uma margarida e veja se a flor se fecha perto do anoitecer."

#: solarui/garden/prompts.lua
msgid "Look for a bee at a flower early in the day, when the bees are slow with cold."
msgstr "Procure uma abelha numa flor no começo do dia, quando as abelhas estão lentas de frio."

#: solarui/garden/prompts.lua
msgid "the first bee"
msgstr "a primeira abelha"

#: solarui/garden/prompts.lua
msgid "Watch a hedge from a distance for a bird carrying twigs, and leave any nest alone."
msgstr "Observe uma sebe de longe à procura de um pássaro carregando gravetos, e deixe qualquer ninho em paz."

#: solarui/garden/prompts.lua
msgid "Listen for a bird singing before dawn, and count the singers."
msgstr "Escute um pássaro cantando antes do amanhecer e conte os cantores."

#: solarui/garden/prompts.lua
msgid "Listen to rain on leaves, on a roof and on the ground, and notice how each sounds different."
msgstr "Escute a chuva nas folhas, num telhado e no chão, e repare como cada uma soa diferente."

#: solarui/garden/prompts.lua
msgid "Stand quietly near blossom and listen for the buzz of insects."
msgstr "Fique quieto perto de flores e escute o zumbido dos insetos."

#: solarui/garden/prompts.lua
msgid "Listen to the wind in new leaves, and compare the sound with the wind in bare branches."
msgstr "Escute o vento nas folhas novas e compare o som com o vento nos galhos nus."

#: solarui/garden/prompts.lua
msgid "Listen for a woodpecker drumming on a tree."
msgstr "Escute um pica-pau batendo numa árvore."

#: solarui/garden/prompts.lua
msgid "Listen at dusk for the last bird to stop singing."
msgstr "Escute ao entardecer o último pássaro a parar de cantar."

#: solarui/garden/prompts.lua
msgid "Listen at a pond or a ditch for the first frog calling, and remember the day."
msgstr "Escute num lago ou numa vala a primeira rã coaxando e guarde o dia."

#: solarui/garden/prompts.lua
msgid "the first frog calling"
msgstr "a primeira rã coaxando"

#: solarui/garden/prompts.lua
msgid "Listen at a hedge for the rustle and chirps of birds looking for nest material."
msgstr "Escute numa sebe o farfalhar e o pipilar de pássaros à procura de material para o ninho."

#: solarui/garden/prompts.lua
msgid "Plant a seed or a bulb in a pot and write the date on a label beside the pot."
msgstr "Plante uma semente ou um bulbo num vaso e escreva a data numa etiqueta ao lado."

#: solarui/garden/prompts.lua
msgid "Take your book outside and read one page under the open sky."
msgstr "Leve seu livro para fora e leia uma página sob o céu aberto."

#: solarui/garden/prompts.lua
msgid "Walk a path near where you live that you have never taken."
msgstr "Faça um caminho perto de onde você mora que nunca fez antes."

#: solarui/garden/prompts.lua
msgid "Water a plant outdoors or on a sill and watch the water sink into the soil."
msgstr "Regue uma planta ao ar livre ou no parapeito e veja a água descer na terra."

#: solarui/garden/prompts.lua
msgid "Put out a bowl of water for the birds and keep the bowl full for a week."
msgstr "Ponha uma tigela de água para os pássaros e mantenha-a cheia por uma semana."

#: solarui/garden/prompts.lua
msgid "Take a photograph of the same tree each week, starting now."
msgstr "Tire uma foto da mesma árvore toda semana, a começar agora."

#: solarui/garden/prompts.lua
msgid "Spend a quarter of an hour outside without your phone."
msgstr "Passe um quarto de hora ao ar livre sem o celular."

#: solarui/garden/prompts.lua
msgid "Sit on the ground and look closely at everything at the height of your hand."
msgstr "Sente-se no chão e olhe de perto tudo o que está à altura da sua mão."

#: solarui/garden/prompts.lua
msgid "Take a deep breath outside and name three smells."
msgstr "Respire fundo ao ar livre e dê nome a três cheiros."

#: solarui/garden/prompts.lua
msgid "Find a flower with a bee on the petals and watch how long the bee stays and where the bee goes next."
msgstr "Encontre uma flor com uma abelha nas pétalas e veja quanto tempo ela fica e para onde vai depois."

#: solarui/garden/prompts.lua
msgid "Listen at dusk for crickets, grasshoppers or birds settling for the night."
msgstr "Escute ao entardecer grilos, gafanhotos ou pássaros se acomodando para a noite."

#: solarui/garden/prompts.lua
msgid "Sit in the shade for ten minutes without your phone and notice everything that moves."
msgstr "Fique dez minutos na sombra sem o celular e repare em tudo o que se move."

#: solarui/garden/prompts.lua
msgid "Find three kinds of seeds and compare how each one is made to travel."
msgstr "Encontre três tipos de sementes e compare como cada uma é feita para viajar."

#: solarui/garden/prompts.lua
msgid "Close your eyes in a park or garden and listen for the nearest bird, then the next nearest."
msgstr "Feche os olhos num parque ou jardim e escute o pássaro mais próximo, depois o seguinte."

#: solarui/garden/prompts.lua
msgid "Leave a shallow dish of water out for birds and insects, and see who comes."
msgstr "Deixe um prato raso com água para pássaros e insetos e veja quem aparece."

#: solarui/garden/prompts.lua
msgid "Look early in the morning for a spider's web, when the dew makes every thread show."
msgstr "Procure cedo de manhã uma teia de aranha, quando o orvalho faz cada fio aparecer."

#: solarui/garden/prompts.lua
msgid "Stand still near flowers and listen for the hum of bees."
msgstr "Fique parado perto de flores e escute o zumbido das abelhas."

#: solarui/garden/prompts.lua
msgid "Lie on the grass and look up through the branches of a tree for a few minutes."
msgstr "Deite na grama e olhe para cima, entre os galhos de uma árvore, por alguns minutos."

#: solarui/garden/prompts.lua
msgid "Watch the sky at dusk for swifts, swallows, bats or moths."
msgstr "Observe o céu ao entardecer à procura de andorinhões, andorinhas, morcegos ou mariposas."

#: solarui/garden/prompts.lua
msgid "Find the tallest tree near you and listen to the wind in the top."
msgstr "Encontre a árvore mais alta perto de você e escute o vento no topo."

#: solarui/garden/prompts.lua
msgid "Walk barefoot on grass, sand or soil for a few minutes, if the ground is safe."
msgstr "Ande descalço na grama, na areia ou na terra por alguns minutos, se o chão for seguro."

#: solarui/garden/prompts.lua
msgid "Find a butterfly resting with closed wings and look at the underside, then wait for the wings to open."
msgstr "Encontre uma borboleta pousada de asas fechadas e olhe a parte de baixo, depois espere as asas se abrirem."

#: solarui/garden/prompts.lua
msgid "Look at the sky and name the clouds: high wisps, fluffy heaps or a flat grey sheet."
msgstr "Olhe o céu e dê nome às nuvens: fiapos altos, montes fofos ou um lençol cinza e liso."

#: solarui/garden/prompts.lua
msgid "Mark the shadow of a tree at noon and again two hours later, and see how far the shadow has moved."
msgstr "Marque a sombra de uma árvore ao meio-dia e de novo duas horas depois, e veja quanto a sombra andou."

#: solarui/garden/prompts.lua
msgid "Look closely at a daisy or a dandelion and see that the one flower is really many small flowers."
msgstr "Olhe de perto uma margarida ou um dente-de-leão e veja que a flor única são, na verdade, muitas florezinhas."

#: solarui/garden/prompts.lua
msgid "Find a snail or a slug on a damp morning and follow the trail."
msgstr "Encontre um caracol ou uma lesma numa manhã úmida e siga o rastro."

#: solarui/garden/prompts.lua
msgid "Find the spot where a flower has fallen and a fruit is starting to form."
msgstr "Encontre o ponto onde uma flor caiu e um fruto começa a se formar."

#: solarui/garden/prompts.lua
msgid "Watch an ant trail for a minute and see what the ants are carrying."
msgstr "Observe uma fila de formigas por um minuto e veja o que elas carregam."

#: solarui/garden/prompts.lua
msgid "Look for the first ripe berry of the summer and remember the day."
msgstr "Procure a primeira frutinha madura do verão e guarde o dia."

#: solarui/garden/prompts.lua
msgid "the first ripe berry"
msgstr "a primeira frutinha madura"

#: solarui/garden/prompts.lua
msgid "Listen to a hot afternoon: what has gone quiet, and what has not?"
msgstr "Escute uma tarde quente: o que ficou em silêncio, e o que não?"

#: solarui/garden/prompts.lua
msgid "Listen for a bird that sounds like a question, and try to find the singer."
msgstr "Escute um pássaro que soa como uma pergunta e tente achar quem canta."

#: solarui/garden/prompts.lua
msgid "Listen to water: a stream, a fountain, a tap or a puddle. Which is the gentlest?"
msgstr "Escute a água: um riacho, uma fonte, uma torneira ou uma poça. Qual é a mais suave?"

#: solarui/garden/prompts.lua
msgid "Sit near a hedge and listen for the small rustles of wrens and sparrows."
msgstr "Sente-se perto de uma sebe e escute os pequenos farfalhares de carriças e pardais."

#: solarui/garden/prompts.lua
msgid "Listen for the first swift screaming overhead, and remember the day."
msgstr "Escute o primeiro andorinhão gritando lá no alto e guarde o dia."

#: solarui/garden/prompts.lua
msgid "the first swift"
msgstr "o primeiro andorinhão"

#: solarui/garden/prompts.lua
msgid "Listen to a storm arriving: the wind first, then the hush, then the rain."
msgstr "Escute uma tempestade chegando: primeiro o vento, depois o silêncio, depois a chuva."

#: solarui/garden/prompts.lua
msgid "Listen at the edge of a field to the dry whisper of long grass."
msgstr "Escute na beira de um campo o sussurro seco do capim alto."

#: solarui/garden/prompts.lua
msgid "Listen at night through an open window to the sounds of the dark."
msgstr "Escute à noite, por uma janela aberta, os sons do escuro."

#: solarui/garden/prompts.lua
msgid "Water a thirsty plant in the cool of the evening, and watch the leaves lift."
msgstr "Regue uma planta com sede no frescor da noite e veja as folhas se erguerem."

#: solarui/garden/prompts.lua
msgid "Pick up a smooth stone and carry the stone for a day, then return the stone to where you found the stone."
msgstr "Pegue uma pedra lisa e carregue-a por um dia, depois devolva-a ao lugar onde a encontrou."

#: solarui/garden/prompts.lua
msgid "Eat something outside, a piece of fruit if you can, and notice every taste."
msgstr "Coma alguma coisa ao ar livre, uma fruta se puder, e repare em cada sabor."

#: solarui/garden/prompts.lua
msgid "Leave a patch of lawn unmown or a corner of a window box wild, and see who moves in."
msgstr "Deixe um trecho de gramado sem cortar ou um canto da jardineira selvagem e veja quem se muda para lá."

#: solarui/garden/prompts.lua
msgid "Take your book outside and read in the shade for twenty minutes."
msgstr "Leve seu livro para fora e leia na sombra por vinte minutos."

#: solarui/garden/prompts.lua
msgid "Go out an hour before sunset and walk until the light turns gold."
msgstr "Saia uma hora antes do pôr do sol e caminhe até a luz ficar dourada."

#: solarui/garden/prompts.lua
msgid "Sit by water and put a hand in the water."
msgstr "Sente-se junto à água e ponha a mão nela."

#: solarui/garden/prompts.lua
msgid "Press a flower or a leaf between the pages of a heavy book."
msgstr "Prense uma flor ou uma folha entre as páginas de um livro pesado."

#: solarui/garden/prompts.lua
msgid "Draw a plant you can see, even badly, and put the date on the drawing."
msgstr "Desenhe uma planta que você veja, mesmo mal, e ponha a data no desenho."

#: solarui/garden/prompts.lua
msgid "Gather leaves of three colours and set them in a line from green to red."
msgstr "Junte folhas de três cores e disponha-as em fila, do verde ao vermelho."

#: solarui/garden/prompts.lua
msgid "Listen for geese, starlings or other flocks passing overhead."
msgstr "Escute gansos, estorninhos ou outros bandos passando no alto."

#: solarui/garden/prompts.lua
msgid "Leave a pile of leaves in a quiet corner, where a hedgehog or a beetle might shelter."
msgstr "Deixe uma pilha de folhas num canto sossegado, onde um ouriço ou um besouro possa se abrigar."

#: solarui/garden/prompts.lua
msgid "Look for a bird eating berries and notice which berries are chosen."
msgstr "Procure um pássaro comendo frutinhas e repare em quais ele escolhe."

#: solarui/garden/prompts.lua
msgid "Walk on dry leaves and listen to how each kind crunches."
msgstr "Ande sobre folhas secas e escute como cada tipo estala."

#: solarui/garden/prompts.lua
msgid "Collect three seeds or nuts, such as acorns, conkers or maple keys, and look at how each is made."
msgstr "Colecione três sementes ou nozes, como bolotas, castanhas ou sâmaras de bordo, e olhe como cada uma é feita."

#: solarui/garden/prompts.lua
msgid "Look for mushrooms in the leaf litter. Look closely, and do not touch or taste."
msgstr "Procure cogumelos entre as folhas caídas. Olhe de perto, sem tocar nem provar."

#: solarui/garden/prompts.lua
msgid "On a still evening, listen for an owl or a robin singing in the dusk."
msgstr "Numa noite calma, escute uma coruja ou um pintarroxo cantando no lusco-fusco."

#: solarui/garden/prompts.lua
msgid "Watch a sunset and notice how early the sun goes down now."
msgstr "Veja um pôr do sol e repare como o sol se põe cedo agora."

#: solarui/garden/prompts.lua
msgid "Find one seed that flies on the wind, one that sticks to clothes and one that animals eat."
msgstr "Encontre uma semente que voa com o vento, uma que gruda na roupa e uma que os animais comem."

#: solarui/garden/prompts.lua
msgid "Stand under a tree as the leaves fall and listen for the small sound of each one landing."
msgstr "Fique sob uma árvore enquanto as folhas caem e escute o pequeno som de cada uma pousando."

#: solarui/garden/prompts.lua
msgid "Notice which trees have kept their leaves and which have let them go, and think about why."
msgstr "Repare quais árvores guardaram as folhas e quais as deixaram ir, e pense por quê."

#: solarui/garden/prompts.lua
msgid "Find a spider's web with the spider still at home, and look at how the threads are laid."
msgstr "Encontre uma teia de aranha com a aranha ainda em casa e olhe como os fios estão dispostos."

#: solarui/garden/prompts.lua
msgid "Look at a leaf that is half green and half red, and find where the colours meet."
msgstr "Olhe uma folha metade verde, metade vermelha, e ache onde as cores se encontram."

#: solarui/garden/prompts.lua
msgid "Look at what the first frost or the first fog of the season has covered, and remember the day."
msgstr "Olhe o que a primeira geada ou a primeira neblina da estação cobriu e guarde o dia."

#: solarui/garden/prompts.lua
msgid "the first frost"
msgstr "a primeira geada"

#: solarui/garden/prompts.lua
msgid "Look for a squirrel or a jay burying food, and notice where."
msgstr "Procure um esquilo ou um gaio enterrando comida e repare onde."

#: solarui/garden/prompts.lua
msgid "Look at how high the midday sun is, and compare the height with the summer sun."
msgstr "Veja a altura do sol do meio-dia e compare com a do sol de verão."

#: solarui/garden/prompts.lua
msgid "Find a hedge full of berries and count the colours."
msgstr "Encontre uma sebe cheia de frutinhas e conte as cores."

#: solarui/garden/prompts.lua
msgid "Look up at a flock leaving or arriving, and count them in tens."
msgstr "Olhe para cima, para um bando que parte ou chega, e conte de dez em dez."

#: solarui/garden/prompts.lua
msgid "Listen for an owl or another night bird after dark."
msgstr "Escute uma coruja ou outra ave noturna depois de escurecer."

#: solarui/garden/prompts.lua
msgid "Listen to the wind shaking seed pods and dry stems."
msgstr "Escute o vento sacudindo vagens e talos secos."

#: solarui/garden/prompts.lua
msgid "Listen for the last cricket of the year, and remember the day."
msgstr "Escute o último grilo do ano e guarde o dia."

#: solarui/garden/prompts.lua
msgid "the last cricket"
msgstr "o último grilo"

#: solarui/garden/prompts.lua
msgid "Listen for the call of a bird that has just arrived for the winter."
msgstr "Escute o chamado de uma ave que acabou de chegar para o inverno."

#: solarui/garden/prompts.lua
msgid "Listen to rain on fallen leaves."
msgstr "Escute a chuva nas folhas caídas."

#: solarui/garden/prompts.lua
msgid "Listen to your own steps on a muddy path, then on a dry one."
msgstr "Escute os próprios passos num caminho enlameado, depois num seco."

#: solarui/garden/prompts.lua
msgid "Listen at dusk as the garden gets ready for night, and notice what goes quiet first."
msgstr "Escute ao entardecer o jardim se preparando para a noite e repare o que se cala primeiro."

#: solarui/garden/prompts.lua
msgid "Stand still and follow the faintest sound you can hear for a full minute."
msgstr "Fique parado e siga por um minuto inteiro o som mais fraco que você conseguir ouvir."

#: solarui/garden/prompts.lua
msgid "Rake a few leaves into a heap and walk through the heap."
msgstr "Junte algumas folhas num monte com o ancinho e atravesse o monte."

#: solarui/garden/prompts.lua
msgid "Plant a bulb for the spring, and mark the place."
msgstr "Plante um bulbo para a primavera e marque o lugar."

#: solarui/garden/prompts.lua
msgid "Save the seeds of a flower you like in a paper envelope, and write the name on the envelope."
msgstr "Guarde as sementes de uma flor de que você gosta num envelope de papel e escreva o nome no envelope."

#: solarui/garden/prompts.lua
msgid "Take a walk after rain with a bag for leaves and seeds."
msgstr "Faça uma caminhada depois da chuva com um saco para folhas e sementes."

#: solarui/garden/prompts.lua
msgid "Note the date the first tree in your street turns."
msgstr "Anote a data em que a primeira árvore da sua rua muda de cor."

#: solarui/garden/prompts.lua
msgid "Take your book outside and read in the last warm sun."
msgstr "Leve seu livro para fora e leia no último sol quente."

#: solarui/garden/prompts.lua
msgid "Buy or gather something of the season, such as apples, pumpkins or nuts, and taste the first bite outdoors."
msgstr "Compre ou colha algo da estação, como maçãs, abóboras ou nozes, e saboreie a primeira mordida ao ar livre."

#: solarui/garden/prompts.lua
msgid "Cut back what has finished in your pots or window box, and leave what is still flowering."
msgstr "Pode o que já terminou nos seus vasos ou na jardineira e deixe o que ainda está florindo."

#: solarui/garden/prompts.lua
msgid "Go outside at dusk with a hot drink and watch the light go."
msgstr "Saia ao entardecer com uma bebida quente e veja a luz se despedir."

#: solarui/garden/prompts.lua
msgid "Take a leaf from a tree and find out the name of the tree."
msgstr "Pegue uma folha de uma árvore e descubra o nome da árvore."

#: solarui/garden/prompts.lua
msgid "Look for tracks in frost, mud or snow, and follow one set for as far as the tracks go."
msgstr "Procure pegadas na geada, na lama ou na neve e siga um rastro até onde ele for."

#: solarui/garden/prompts.lua
msgid "Stand outside after snow and listen to how quiet the world has become."
msgstr "Fique do lado de fora depois da neve e escute como o mundo ficou quieto."

#: solarui/garden/prompts.lua
msgid "Hang up food for the birds, or put out fresh water, and watch who comes."
msgstr "Pendure comida para os pássaros, ou ponha água fresca, e veja quem vem."

#: solarui/garden/prompts.lua
msgid "Find the bud at the end of a bare branch, small and tightly closed."
msgstr "Encontre o botão na ponta de um galho nu, pequeno e bem fechado."

#: solarui/garden/prompts.lua
msgid "Listen for a robin or a wren singing in the cold."
msgstr "Escute um pintarroxo ou uma carriça cantando no frio."

#: solarui/garden/prompts.lua
msgid "Go out on a clear night, let your eyes adjust for ten minutes, and find one constellation."
msgstr "Saia numa noite clara, deixe os olhos se acostumarem por dez minutos e encontre uma constelação."

#: solarui/garden/prompts.lua
msgid "Find something green in the middle of winter, and ask what the plant is doing."
msgstr "Encontre algo verde em pleno inverno e pergunte o que a planta está fazendo."

#: solarui/garden/prompts.lua
msgid "Listen to your own footsteps on frost, leaves or snow."
msgstr "Escute os próprios passos na geada, nas folhas ou na neve."

#: solarui/garden/prompts.lua
msgid "Walk for twenty minutes in daylight, however cold, and notice how long the shadows are."
msgstr "Caminhe vinte minutos à luz do dia, por mais frio que esteja, e repare como as sombras são longas."

#: solarui/garden/prompts.lua
msgid "Count the birds in a hedge or at a feeder for five minutes."
msgstr "Conte os pássaros numa sebe ou num comedouro por cinco minutos."

#: solarui/garden/prompts.lua
msgid "Stand by a frozen puddle or pond and listen for the ice creaking."
msgstr "Fique junto a uma poça ou lago congelado e escute o gelo ranger."

#: solarui/garden/prompts.lua
msgid "Look for the first snowdrop or catkin of the year, and remember the date."
msgstr "Procure o primeiro galanto ou amentilho do ano e guarde a data."

#: solarui/garden/prompts.lua
msgid "the first snowdrop or catkin"
msgstr "o primeiro galanto ou amentilho"

#: solarui/garden/prompts.lua
msgid "Look at your breath in the cold air and watch where the breath goes."
msgstr "Olhe seu hálito no ar frio e veja para onde ele vai."

#: solarui/garden/prompts.lua
msgid "Find an icicle or a pattern of frost and look closely at the shape."
msgstr "Encontre um pingente de gelo ou um desenho de geada e olhe de perto a forma."

#: solarui/garden/prompts.lua
msgid "Look for a bird's nest in a bare tree, where the nest can now be seen, and leave the nest alone."
msgstr "Procure um ninho numa árvore nua, onde agora ele pode ser visto, e deixe o ninho em paz."

#: solarui/garden/prompts.lua
msgid "Look at the stars and find the brightest one. Does the star twinkle?"
msgstr "Olhe as estrelas e ache a mais brilhante. Ela cintila?"

#: solarui/garden/prompts.lua
msgid "Watch a sunrise or a sunset and notice where the sun comes up or goes down compared with last month."
msgstr "Veja um nascer ou um pôr do sol e repare onde o sol nasce ou se põe em comparação com o mês passado."

#: solarui/garden/prompts.lua
msgid "Find a plant that has kept the berries and see who comes to eat them."
msgstr "Encontre uma planta que guardou as frutinhas e veja quem vem comê-las."

#: solarui/garden/prompts.lua
msgid "Listen for the sound of snow falling, or for the quiet that comes with the snow."
msgstr "Escute o som da neve caindo, ou o silêncio que vem com ela."

#: solarui/garden/prompts.lua
msgid "Listen for a bird calling on a frosty morning and try to find the singer."
msgstr "Escute um pássaro chamando numa manhã de geada e tente achar quem canta."

#: solarui/garden/prompts.lua
msgid "Listen for geese or other winter birds overhead at dusk."
msgstr "Escute gansos ou outras aves de inverno no alto, ao entardecer."

#: solarui/garden/prompts.lua
msgid "Listen to the wind on a cold night from indoors, and think where the wind has been."
msgstr "Escute de dentro de casa o vento numa noite fria e pense por onde ele andou."

#: solarui/garden/prompts.lua
msgid "Listen to wet leaves underfoot, and compare them with dry ones."
msgstr "Escute folhas molhadas sob os pés e compare com as secas."

#: solarui/garden/prompts.lua
msgid "Listen for tits and finches moving through the garden in a flock."
msgstr "Escute chapins e tentilhões atravessando o jardim em bando."

#: solarui/garden/prompts.lua
msgid "Listen at a window to the dawn and notice how late the first song starts now."
msgstr "Escute da janela o amanhecer e repare como o primeiro canto começa tarde agora."

#: solarui/garden/prompts.lua
msgid "Listen for the first song of any bird other than a robin, and remember the day."
msgstr "Escute o primeiro canto de qualquer ave que não seja um pintarroxo e guarde o dia."

#: solarui/garden/prompts.lua
msgid "the first new birdsong"
msgstr "o primeiro canto novo de pássaro"

#: solarui/garden/prompts.lua
msgid "Fill a bird feeder and keep the feeder full for a week."
msgstr "Encha um comedouro de pássaros e mantenha-o cheio por uma semana."

#: solarui/garden/prompts.lua
msgid "Press a finger into frost or snow and look at the mark left behind."
msgstr "Pressione um dedo na geada ou na neve e olhe a marca que fica."

#: solarui/garden/prompts.lua
msgid "Take your book outside, wrapped up warm, and read one page in the cold."
msgstr "Leve seu livro para fora, bem agasalhado, e leia uma página no frio."

#: solarui/garden/prompts.lua
msgid "Sow a seed on a windowsill and watch for the first green."
msgstr "Semeie uma semente num parapeito e espere o primeiro verde."

#: solarui/garden/prompts.lua
msgid "Put a pine cone, a seed head or a twig on a windowsill and draw the shape."
msgstr "Ponha uma pinha, uma flor seca ou um galhinho no parapeito e desenhe a forma."

#: solarui/garden/prompts.lua
msgid "Go out at first light and be there for the sunrise."
msgstr "Saia ao primeiro raio de luz e esteja lá para o nascer do sol."

#: solarui/garden/prompts.lua
