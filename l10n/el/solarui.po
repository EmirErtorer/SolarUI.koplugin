#: solarui/ui/gardenseason.lua
msgid "Follow the calendar"
msgstr "Ακολούθησε το ημερολόγιο"

#: solarui/ui/gardensit.lua
msgid "Open my book"
msgstr "Άνοιγμα του βιβλίου μου"

#: solarui/ui/gardensit.lua
msgid "Sit a little longer"
msgstr "Κάτσε λίγο ακόμη"

#: solarui/ui/gardensit.lua
msgid "A good while"
msgstr "Αρκετή ώρα"

#: solarui/ui/gardensit.lua
msgid "The garden kept still for you. Whenever you are ready, there is a book waiting."
msgstr "Ο κήπος έμεινε ακίνητος για σένα. Όποτε είσαι έτοιμος, ένα βιβλίο περιμένει."

#: solarui/ui/homecompanion.lua
msgid "Wilted"
msgstr "Μαραμένο"

#: solarui/ui/homecompanion.lua
msgid "Thirsty"
msgstr "Διψασμένο"

#: solarui/ui/homecompanion.lua
msgid "Only just cared for."
msgstr "Μόλις φροντίστηκε."

#: solarui/ui/homecompanion.lua
msgid "%s · day %d"
msgstr "%s · μέρα %d"

#: solarui/ui/homecompanion.lua
msgid "Tap to chat. Hold to open their page."
msgstr "Πάτησε για κουβεντούλα. Κράτα πατημένο για να ανοίξει η σελίδα τους."

