msgstr "meszki"

#: solarui/garden/cast.lua
msgid "Marsh frog"
msgstr "Żaba śmieszka"

#: solarui/garden/cast.lua
msgid "flies"
msgstr "muchy"

#: solarui/garden/cast.lua
msgid "Koi carp"
msgstr "Karp koi"

#: solarui/garden/cast.lua
msgid "pond weed"
msgstr "rośliny wodne"

#: solarui/garden/cast.lua
msgid "European hedgehog"
msgstr "Jeż europejski"

#: solarui/garden/cast.lua
msgid "beetles and slugs"
msgstr "chrząszcze i ślimaki nagie"

#: solarui/garden/cast.lua
msgid "Elephant hawk-moth"
msgstr "Fruczak tawulec"

#: solarui/garden/cast.lua
msgid "Red fox"
msgstr "Lis rudy"

#: solarui/garden/cast.lua
msgid "field mice"
msgstr "myszy polne"

#: solarui/garden/cast.lua
msgid "Indian peafowl"
msgstr "Paw indyjski"

#: solarui/garden/cast.lua
msgid "seeds and berries"
msgstr "nasiona i jagody"

#: solarui/garden/cast.lua
msgid "known by many, many names across the multiverse"
msgstr "znana pod wieloma, wieloma imionami w całym multiwersum"

#: solarui/garden/cast.lua
msgid "salami above all, then kebab, chicken, minced meat, cheese and yogurt"
msgstr "przede wszystkim salami, potem kebab, kurczak, mielone mięso, ser i jogurt"

#: solarui/garden/journal.lua
msgid "%s was coaxed into bloom with a seed."
msgstr "%s zakwita, zachęcone nasionem."

#: solarui/garden/journal.lua
msgid "A seed was spent on %s, and the flowers came at once."
msgstr "Na %s poszło nasionko i kwiaty pojawiły się od razu."

#: solarui/garden/journal.lua
msgid "%s took the hint and bloomed."
msgstr "%s zrozumie aluzję i zakwita."

#: solarui/garden/journal.lua
msgid "%s came up."
msgstr "%s wschodzi."

#: solarui/garden/journal.lua
msgid "%s put out the first leaves."
msgstr "%s wypuszcza pierwsze liście."

#: solarui/garden/journal.lua
msgid "%s sprouted, with no fuss."
msgstr "%s kiełkuje bez zamieszania."

#: solarui/garden/journal.lua
msgid "%s made a bud."
msgstr "%s zawiązuje pąk."

#: solarui/garden/journal.lua
msgid "%s is thinking about flowering."
msgstr "%s rozważa kwitnienie."

#: solarui/garden/journal.lua
msgid "%s has a bud and a plan."
msgstr "%s ma pąk i plan."

#: solarui/garden/journal.lua
msgid "%s bloomed."
msgstr "%s zakwita."

#: solarui/garden/journal.lua
msgid "%s opened, and looked pleased."
msgstr "%s rozchyla płatki i wygląda na zadowolone."

#: solarui/garden/journal.lua
msgid "%s is in flower."
msgstr "%s jest w pełni kwitnienia."

#: solarui/garden/journal.lua
msgid "%s has gone to seed."
msgstr "%s zawiązuje nasiona."

#: solarui/garden/journal.lua
msgid "%s let the seeds ripen."
msgstr "%s pozwala nasionom dojrzeć."

#: solarui/garden/journal.lua
msgid "%s is done flowering, and can be cut back."
msgstr "%s przekwitło i można je przyciąć."

#: solarui/garden/journal.lua
msgid "%s wilted from thirst."
msgstr "%s więdnie z pragnienia."

#: solarui/garden/journal.lua
msgid "%s drooped, plainly and on purpose."
msgstr "%s opada, otwarcie i celowo."

#: solarui/garden/journal.lua
msgid "%s ran dry and gave up for now."
msgstr "%s wyschło i na razie się poddaje."

#: solarui/garden/journal.lua
msgid "%s found the garden."
msgstr "%s znajduje ogród."

#: solarui/garden/journal.lua
msgid "%s arrived, uninvited and welcome."
msgstr "%s przybywa nieproszony i mile widziany."

#: solarui/garden/journal.lua
msgid "%s turned up, as if the garden had always been home."
msgstr "%s pojawia się, jakby ogród zawsze był domem."

#: solarui/garden/journal.lua
msgid "%s went into hiding, hungry."
msgstr "%s chowa się, głodny."

#: solarui/garden/journal.lua
msgid "%s was not seen all day, and is hungry."
msgstr "%s nie pokazuje się cały dzień i jest głodny."

#: solarui/garden/journal.lua
msgid "%s has hidden away until someone brings a meal."
msgstr "%s ukrywa się, aż ktoś przyniesie posiłek."

#: solarui/garden/journal.lua
msgid "%s visited %s."
msgstr "%s odwiedza: %s."

#: solarui/garden/journal.lua
msgid "%s spent the afternoon at %s."
msgstr "%s spędza popołudnie przy: %s."

#: solarui/garden/journal.lua
msgid "%s called on %s, and left pollen behind."
msgstr "%s zagląda do: %s i zostawia pyłek."

#: solarui/garden/journal.lua
msgid "You read %d pages. %s drank from them."
msgstr "Przeczytano %d stron. %s pije z nich."

#: solarui/garden/journal.lua
msgid "%d pages came in, and %s was watered by them."
msgstr "Przybyło %d stron i podlały %s."

#: solarui/garden/journal.lua
msgid "%d pages today, and %s has them to thank."
msgstr "%d stron dziś, a dziękować za nie ma komu: %s."

#: solarui/garden/journal.lua
msgid "%s was cut back, and the seeds were kept."
msgstr "%s przycięto, a nasiona zachowano."

#: solarui/garden/journal.lua
msgid "%s was tidied, and a seed saved."
msgstr "%s uporządkowano i odłożono nasionko."

#: solarui/garden/journal.lua
msgid "%s was cut back, and the seeds went into the jar."
msgstr "%s przycięto, a nasiona trafiły do słoika."

#: solarui/garden/journal.lua
msgid "The seeds of %s were left for the birds."
msgstr "Nasiona: %s zostały dla ptaków."

#: solarui/garden/journal.lua
msgid "%s was left standing for the birds."
msgstr "%s zostawiono na pożywienie dla ptaków."

#: solarui/garden/journal.lua
msgid "The birds found the seeds of %s."
msgstr "Ptaki znalazły nasiona: %s."

#: solarui/garden/journal.lua
msgid "The seeds of %s were scattered in the beds."
msgstr "Nasiona: %s rozsypano po grządkach."

#: solarui/garden/journal.lua
msgid "%s dropped a few seeds a little further along."
msgstr "%s upuszcza kilka nasion trochę dalej."

#: solarui/garden/journal.lua
msgid "Some seeds of %s were thrown to the wind."
msgstr "Kilka nasion: %s rzucono na wiatr."

#: solarui/garden/journal.lua
msgid "A seed was left in the wild edge."
msgstr "Nasionko zostało na dzikim obrzeżu."

#: solarui/garden/journal.lua
msgid "A seed went back to the wild."
msgstr "Nasionko wróciło na dziko."

#: solarui/garden/journal.lua
msgid "Something was given back to the wild edge."
msgstr "Coś oddano dzikiemu obrzeżu."

#: solarui/garden/journal.lua
msgid "Rain came in the night, and the beds drank."
msgstr "W nocy spadł deszcz i grządki się napiły."

#: solarui/garden/journal.lua
msgid "Rain fell, and the watering can stayed in the shed."
msgstr "Padał deszcz, a konewka została w szopie."

#: solarui/garden/journal.lua
msgid "A day of rain. Everything was given half a drink."
msgstr "Dzień deszczu. Wszystko dostało pół porcji picia."

#: solarui/garden/journal.lua
msgid "Snow lay on the beds."
msgstr "Śnieg przykrył grządki."

#: solarui/garden/journal.lua
msgid "Snow came, and the garden went quiet."
msgstr "Przyszedł śnieg i ogród ucichł."

#: solarui/garden/journal.lua
msgid "The first snow settled on the lawn."
msgstr "Pierwszy śnieg osiadł na trawniku."

#: solarui/garden/journal.lua
msgid "You went outside and looked, and ticked the week off."
msgstr "Wyszedłeś na dwór, rozejrzałeś się i odhaczyłeś tydzień."

#: solarui/garden/journal.lua
msgid "A week's walk was ticked off."
msgstr "Odhaczono tygodniowy spacer."

#: solarui/garden/journal.lua
msgid "The garden was glad to hear you went out."
msgstr "Ogród cieszy się, że wyszedłeś na dwór."

#: solarui/garden/journal.lua
msgid "%s peeked out of the grass, and you saw."
msgstr "%s wyglądało z trawy, a ty to zobaczyłeś."

#: solarui/garden/journal.lua
msgid "You spotted %s watching from the grass."
msgstr "Zauważyłeś, że %s obserwuje z trawy."

#: solarui/garden/journal.lua
msgid "%s was hiding in plain sight, and you found the spot."
msgstr "%s chowa się na widoku, a ty znalazłeś to miejsce."

#: solarui/garden/journal.lua
msgid "A new bed was laid out: %s."
msgstr "Nowa grządka została założona: %s."

#: solarui/garden/journal.lua
msgid "%s was planted in the corner of the lawn."
msgstr "%s posadzono w rogu trawnika."

#: solarui/garden/journal.lua
msgid "The ground was ready, and %s went in."
msgstr "Ziemia była gotowa i wszedł do niej: %s."

#: solarui/garden/journal.lua
msgid "The harvest of %s was shared round the garden."
msgstr "Plony z: %s podzielono po całym ogrodzie."

#: solarui/garden/journal.lua
msgid "%s was picked, and nobody went hungry."
msgstr "%s zerwano i nikt nie został głodny."

#: solarui/garden/journal.lua
msgid "The harvest from %s fed the garden's visitors."
msgstr "Plony z: %s nakarmiły gości ogrodu."

#: solarui/garden/journal.lua
msgid "%s began."
msgstr "%s się zaczyna."

#: solarui/garden/journal.lua
msgid "The garden turned to %s."
msgstr "Ogród zwraca się ku: %s."

#: solarui/garden/journal.lua
msgid "%s came round again, on time."
msgstr "%s wraca, punktualnie."

#: solarui/garden/journal.lua
msgid "%s was here all along. The garden has only now noticed."
msgstr "%s jest tu od zawsze. Ogród dopiero teraz to zauważył."

#: solarui/garden/journal.lua
msgid "%s has always ruled this garden, and today the garden said so."
msgstr "%s od zawsze rządzi tym ogrodem, a dziś ogród to przyznał."

#: solarui/garden/journal.lua
msgid "%s looked the garden over and allowed the garden to go on."
msgstr "%s obejrzała ogród i pozwoliła mu trwać dalej."

#: solarui/garden/journal.lua
msgid "%s is hungry and is not hiding. She is demanding."
msgstr "%s jest głodna i się nie chowa. Jest wymagająca."

#: solarui/garden/journal.lua
msgid "%s waited by the dish, and the waiting had teeth."
msgstr "%s czekała przy misce, a czekanie miało zęby."

#: solarui/garden/journal.lua
msgid "%s stared at the kitchen door until somebody felt guilty."
msgstr "%s wpatrywała się w drzwi kuchni, aż ktoś poczuł się winny."

#: solarui/garden/journal.lua
msgid "%s bit someone. There was blood."
msgstr "%s ugryzła kogoś. Była krew."

#: solarui/garden/journal.lua
msgid "%s drew blood, and regrets nothing."
msgstr "%s przelała krew i niczego nie żałuje."

#: solarui/garden/journal.lua
msgid "A hand went too far, and %s answered with teeth."
msgstr "Ręka poszła za daleko, a %s odpowiedziała zębami."

#: solarui/garden/journal.lua
msgid "%s came back out for a meal."
msgstr "%s wychodzi na posiłek."

#: solarui/garden/journal.lua
msgid "%s was fed and showed up at once."
msgstr "%s została nakarmiona i pojawiła się od razu."

#: solarui/garden/journal.lua
msgid "%s is back, and no questions asked."
msgstr "%s wróciła, bez pytań."

#: solarui/garden/lore.lua
msgid "The poet's narcissus flowers late in spring and grows wild in the mountain meadows of southern Europe. Their scent is heavy and sweet. Every part of the plant is poisonous, the bulb most of all."
msgstr "Narcyz poetycki kwitnie późną wiosną i rośnie dziko na górskich łąkach południowej Europy. Jego zapach jest ciężki i słodki. Każda część rośliny jest trująca, najbardziej cebula."

#: solarui/garden/lore.lua
msgid "The spring crocus grows from a small corm and often flowers through the last snow in the mountains of Europe. Their petals open in the sun and close at dusk. Saffron comes from a different crocus."
msgstr "Szafran wiosenny wyrasta z małej bulwy i często kwitnie przez ostatni śnieg w górach Europy. Jego płatki otwierają się w słońcu i zamykają o zmierzchu. Szafran przyprawowy pochodzi z innego krokusa."

#: solarui/garden/lore.lua
msgid "The garden pansy was bred in the nineteenth century from the wild heartsease. The name comes from the French word for a thought. Pansies like cool weather, and their flowers can be eaten."
msgstr "Bratek ogrodowy wyhodowano w XIX wieku z dzikiego bratka trójbarwnego. Francuska nazwa oznacza myśl. Bratki lubią chłodną pogodę, a ich kwiaty można jeść."

#: solarui/garden/lore.lua
msgid "The Madonna lily is one of the oldest garden plants there is, painted on Minoan walls more than three thousand years ago. They flower in early summer and smell strongly. Lilies of this kind are dangerous to cats."
msgstr "Lilia biała to jedna z najstarszych roślin ogrodowych, malowana na minojskich ścianach ponad trzy tysiące lat temu. Kwitnie na początku lata i silnie pachnie. Takie lilie są niebezpieczne dla kotów."

#: solarui/garden/lore.lua
msgid "Chamomile is a small annual cousin of the daisy. Dried, the flower heads make a calming tea. The cone in the middle of each flower is hollow, which tells chamomile from similar plants."
msgstr "Rumianek to mały, jednoroczny kuzyn stokrotki. Suszone koszyczki dają uspokajającą herbatę. Stożek pośrodku każdego kwiatu jest pusty w środku, po czym rozpoznaje się rumianek wśród podobnych roślin."

#: solarui/garden/lore.lua
msgid "Each dandelion flower is a head of many tiny flowers. When they have set seed, every seed carries a parachute of fluff. The long taproot reaches deep, and the early blooms feed bees after winter."
msgstr "Każdy kwiat mniszka to główka wielu drobnych kwiatków. Gdy zawiążą nasiona, każde niesie spadochron z puchu. Długi korzeń palowy sięga głęboko, a wczesne kwiaty karmią pszczoły po zimie."

#: solarui/garden/lore.lua
msgid "The Norway maple has leaves with pointed lobes, and a torn stalk bleeds a milky sap. Their seeds are paired wings that spin down like small helicopters. In autumn the leaves turn yellow."
msgstr "Klon zwyczajny ma liście z ostrymi klapami, a oderwany ogonek roni mleczny sok. Jego nasiona to sparowane skrzydełka, które wirują w dół jak małe śmigłowce. Jesienią liście żółkną."

#: solarui/garden/lore.lua
msgid "The damask rose is an old hybrid, grown for rose water and rose oil. Isparta in Turkey and the Rose Valley in Bulgaria are famous for roses. The petals are picked at dawn, before the sun draws out the scent."
msgstr "Róża damasceńska to stara mieszanka, uprawiana dla wody różanej i olejku różanego. Isparta w Turcji i Dolina Róż w Bułgarii słyną z róż. Płatki zbiera się o świcie, zanim słońce wydobędzie zapach."

#: solarui/garden/lore.lua
msgid "The tulip came from the mountains of Central Asia. The Ottomans prized tulips so much that one age of their court is called the Tulip Era. Dutch growers later paid fortunes for single bulbs."
msgstr "Tulipan przybył z gór Azji Środkowej. Osmanowie tak cenili tulipany, że jedną epokę ich dworu nazywa się Epoką Tulipanów. Holenderscy hodowcy płacili później fortuny za pojedyncze cebulki."

#: solarui/garden/lore.lua
msgid "The ginkgo is the last survivor of a family of trees more than two hundred million years old. Their fan-shaped leaves have veins that fork and never join. In autumn the leaves turn gold and fall almost all at once."
msgstr "Miłorząb to ostatni żyjący przedstawiciel rodziny drzew liczącej ponad dwieście milionów lat. Jego wachlarzowate liście mają żyłki, które się rozwidlają i nigdy nie łączą. Jesienią liście złocą się i opadają niemal wszystkie naraz."

#: solarui/garden/lore.lua
msgid "Bracken is a fern, so bracken grows from spores and never makes a flower or a seed. The young fronds unroll slowly from tight coils. Bracken spreads underground and is one of the most widespread ferns on Earth."
msgstr "Orlica jest paprocią, więc rośnie ze zarodników i nigdy nie wytwarza kwiatu ani nasienia. Młode liście rozwijają się powoli z ciasnych zwojów. Orlica rozrasta się pod ziemią i należy do najbardziej rozpowszechnionych paproci na Ziemi."

#: solarui/garden/lore.lua
msgid "Honesty gets the name from the seed pods, which are round, papery and so thin that the seeds show through. They shine like silver coins. The plant flowers purple in spring and lives for two years."
msgstr "Miesięcznica zawdzięcza angielską nazwę strąkom, które są okrągłe, papierowe i tak cienkie, że nasiona prześwitują. Lśnią jak srebrne monety. Roślina kwitnie na fioletowo wiosną i żyje dwa lata."

#: solarui/garden/lore.lua
msgid "The sunflower came from North America. Young flower heads turn to follow the sun across the sky. The big head is really hundreds of small flowers, set in spirals that are counted by Fibonacci numbers."
msgstr "Słonecznik pochodzi z Ameryki Północnej. Młode kwiatostany obracają się za słońcem na niebie. Wielka główka to w istocie setki małych kwiatów, ułożonych w spirale, które zlicza się liczbami Fibonacciego."

#: solarui/garden/lore.lua
msgid "The white water lily roots in the mud and sends up long stalks so the round leaves can float. The flowers open in the morning and close again in the afternoon. Water lilies need no watering."
msgstr "Grzybienie białe zakorzenia się w mule i wypuszcza długie łodygi, by okrągłe liście mogły pływać. Kwiaty otwierają się rano i zamykają po południu. Grzybienie nie wymagają podlewania."

#: solarui/garden/lore.lua
msgid "The harebell has slender stems that tremble in the lightest wind. Small blue bells nod on them through summer. Harebells grow on dry grassland and dunes across the northern half of the world."
msgstr "Dzwonek ma smukłe łodygi, które drżą na najlżejszym wietrze. Małe niebieskie dzwoneczki kiwają się na nich przez całe lato. Dzwonki rosną na suchych łąkach i wydmach w północnej połowie świata."

#: solarui/garden/lore.lua
msgid "The bearded iris is named after the Greek goddess of the rainbow. The fuzzy beard on the lower petals guides insects in. Irises grow from thick roots called rhizomes, which are dried for perfume."
msgstr "Kosaciec bródkowy nosi imię greckiej bogini tęczy. Puszysta broda na dolnych płatkach prowadzi owady do wnętrza. Kosaćce wyrastają z grubych korzeni zwanych kłączami, które suszy się na perfumy."

#: solarui/garden/lore.lua
msgid "The seeds of the corn poppy can sleep in the soil for decades and wake when the ground is turned. That is why poppies covered the churned fields of old battlefields. Each flower lasts only a day or two."
msgstr "Nasiona maku polnego mogą spać w glebie przez dziesięciolecia i obudzić się, gdy ziemię się przewróci. Dlatego maki pokryły zryte pola dawnych bitew. Każdy kwiat trwa tylko dzień lub dwa."

#: solarui/garden/lore.lua
msgid "Ivy climbs by tiny rootlets, not by tendrils, and stays green through winter. The flowers open late in autumn when little else does, so they feed insects, and the berries feed birds through the cold months."
msgstr "Bluszcz pnie się na drobnych korzonkach, nie wąsach, i zostaje zielony przez zimę. Kwiaty otwierają się późną jesienią, gdy mało co innego kwitnie, więc karmią owady, a jagody karmią ptaki w zimne miesiące."

#: solarui/garden/lore.lua
msgid "Maize, climbing beans and squash are grown together in one mound by many Native peoples of the Americas, and the three plants are called the Three Sisters. The maize holds up the beans, the beans feed the soil with nitrogen, and the broad squash leaves shade the ground. Planted together, each helps the others."
msgstr "Kukurydzę, fasolę pnącą i dynię uprawia razem na jednym kopcu wiele rdzennych ludów obu Ameryk, a te trzy rośliny nazywa się Trzema Siostrami. Kukurydza podtrzymuje fasolę, fasola karmi glebę azotem, a szerokie liście dyni osłaniają ziemię. Posadzone razem, wzajemnie sobie pomagają."

#: solarui/garden/lore.lua
msgid "A honey bee tells the hive where the flowers are by dancing. The angle of the dance shows the direction and the length of the dance shows the distance. A worker lives only a few weeks in summer."
msgstr "Pszczoła miodna mówi ulowi, gdzie są kwiaty, tańcząc. Kąt tańca wskazuje kierunek, a długość tańca odległość. Robotnica żyje latem tylko kilka tygodni."

#: solarui/garden/lore.lua
msgid "The seven-spot ladybird's bright red warns birds of a bad taste. Both the adults and their spiky larvae eat aphids, and a single ladybird can eat hundreds in a life. Ladybirds sleep through winter in a sheltered crack."
msgstr "Jaskrawa czerwień biedronki siedmiokropki ostrzega ptaki przed złym smakiem. Zarówno dorosłe, jak i ich kolczaste larwy zjadają mszyce, a jedna biedronka może zjeść w życiu setki. Biedronki przesypiają zimę w osłoniętej szczelinie."

#: solarui/garden/lore.lua
msgid "A garden snail glides on one muscular foot over a trail of slime. Their tongues are covered with thousands of tiny teeth. In dry weather a snail seals the shell shut and waits for the rain."
msgstr "Ślimak winniczek sunie na jednej mięsistej stopie po śladzie śluzu. Jego język pokrywają tysiące drobnych zębów. W suchą pogodę ślimak zamyka muszlę i czeka na deszcz."

#: solarui/garden/lore.lua
msgid "The swallowtail's caterpillars eat fennel and other plants of the carrot family. The adults taste with their feet and drink nectar through a long tongue kept rolled up. The tails on the hind wings give the swallowtail the name."
msgstr "Gąsienice pazia królowej żywią się koprem włoskim i innymi roślinami z rodziny selerowatych. Dorosłe smakują stopami i piją nektar długim, zwiniętym językiem. Ogonki na tylnych skrzydłach dały paziowi nazwę."

#: solarui/garden/lore.lua
msgid "The European robin sings nearly all year round, and sometimes at night near a lamp. Each robin guards a patch of ground, even in winter. Robins often follow a gardener who is digging, for the worms that turn up."
msgstr "Rudzik śpiewa niemal przez cały rok, a czasem nocą przy lampie. Każdy rudzik strzeże kawałka ziemi, nawet zimą. Rudziki często chodzą za ogrodnikiem, który kopie, za dżdżownicami, które wychodzą na wierzch."

#: solarui/garden/lore.lua
msgid "The emperor dragonfly spends the first year or two as a hunter under the water. The adults hunt on the wing and can move each of the four wings separately. The family has been flying for more than three hundred million years."
msgstr "Husarz władca spędza pierwszy rok lub dwa jako łowca pod wodą. Dorosłe polują w locie i potrafią poruszać każdym z czterech skrzydeł osobno. Ta rodzina lata od ponad trzystu milionów lat."

#: solarui/garden/lore.lua
msgid "The marsh frog is the largest green frog of Europe. The eyes sit high on the head so a frog can watch from the water with only the face showing. In summer the males sing in loud choirs, with a balloon on each cheek."
msgstr "Żaba śmieszka to największa zielona żaba Europy. Oczy siedzą wysoko na głowie, więc żaba może obserwować z wody, pokazując tylko twarz. Latem samce śpiewają w głośnych chórach, z balonikiem na każdym policzku."

#: solarui/garden/lore.lua
msgid "Koi are carp that were bred in Japan for their colours. They live for decades, and they learn to know the person who feeds them. In winter they slow down and rest near the bottom of the pond."
msgstr "Koi to karpie wyhodowane w Japonii dla barw. Żyją dziesiątki lat i uczą się rozpoznawać osobę, która je karmi. Zimą zwalniają i odpoczywają przy dnie stawu."

#: solarui/garden/lore.lua
msgid "A hedgehog has five to seven thousand spines, and rolls into a ball when afraid. Hedgehogs wander at night looking for beetles and slugs. In winter they sleep in a nest of leaves until spring."
msgstr "Jeż ma od pięciu do siedmiu tysięcy kolców i zwija się w kulkę, gdy się boi. Jeże wędrują nocą w poszukiwaniu chrząszczy i ślimaków. Zimą śpią w gnieździe z liści aż do wiosny."

#: solarui/garden/lore.lua
msgid "The elephant hawk-moth is pink and olive green. At dusk the moths hover at flowers like tiny hummingbirds, drinking nectar. The caterpillar has a trunk-like front end, which is how the moth got the name."
msgstr "Fruczak tawulec jest różowy i oliwkowozielony. O zmierzchu ćmy zawisają przy kwiatach jak maleńkie koliberki i piją nektar. Gąsienica ma przód ciała jak trąba, stąd angielska nazwa ćmy."

#: solarui/garden/lore.lua
msgid "The red fox listens for mice under the grass, then leaps and pounces from above. Foxes are mostly active at night and sleep in a den by day. In midwinter the vixen calls with a strange scream."
msgstr "Lis rudy nasłuchuje myszy pod trawą, a potem skacze i spada na nie z góry. Lisy są głównie aktywne nocą, a w dzień śpią w norze. W środku zimy lisica nawołuje dziwnym krzykiem."

#: solarui/garden/lore.lua
msgid "Yüzsüz The Magnificent is the supreme ruler of the known and unknown universe, and of this garden. Her left side allows a hundred and forty pats, her right side three. Belly rubs are welcome until, suddenly, they are not."
msgstr "Yüzsüz The Magnificent jest najwyższą władczynią znanego i nieznanego wszechświata oraz tego ogrodu. Jej lewy bok znosi sto czterdzieści głaskań, prawy trzy. Pieszczoty brzuszka są mile widziane, aż nagle przestają być."

#: solarui/garden/lore.lua
msgid "What looks like the peacock's tail is a train of long feathers growing from the back, over the real tail. Every feather carries an eye. The train is shed each year after summer and grown again by spring."
msgstr "To, co wygląda jak ogon pawia, to tren długich piór wyrastających z grzbietu, nad prawdziwym ogonem. Każde pióro ma oko. Tren jest zrzucany co roku po lecie i odrasta do wiosny."

#: solarui/garden/nature.lua
msgid "The first crocuses open on the sunny side of the hedge, and by afternoon a few bees have found them."
msgstr "Pierwsze krokusy otwierają się po słonecznej stronie żywopłotu, a po południu kilka pszczół już je znajduje."

#: solarui/garden/nature.lua
msgid "Day by day the light stays a little longer. The blackbird sings before anyone is up to hear."
msgstr "Z dnia na dzień światło zostaje trochę dłużej. Kos śpiewa, zanim ktokolwiek wstanie, by go usłyszeć."

#: solarui/garden/nature.lua
msgid "A tulip does not hurry. The leaves come first, then a bud held low and tight, then a week of colour."
msgstr "Tulipan się nie spieszy. Najpierw przychodzą liście, potem pąk trzymany nisko i ciasno, potem tydzień barw."

#: solarui/garden/nature.lua
msgid "After rain the ground smells sweet. Soil bacteria make the scent, and the damp air carries the scent up."
msgstr "Po deszczu ziemia pachnie słodko. Zapach robią bakterie glebowe, a wilgotne powietrze niesie go w górę."

#: solarui/garden/nature.lua
msgid "Dandelions are the first meal many bees find after winter, so leave a few in the grass."
msgstr "Mlecze to pierwszy posiłek, jaki wiele pszczół znajduje po zimie, więc zostaw kilka w trawie."

#: solarui/garden/nature.lua
msgid "Look for the pale new leaves on the maple: they are folded like small hands, and open within days."
msgstr "Poszukaj bladych młodych liści na klonie: są złożone jak małe dłonie i otwierają się w ciągu kilku dni."

#: solarui/garden/nature.lua
msgid "The robin sings from the highest branch, which is how the neighbours learn whose ground this is."
msgstr "Rudzik śpiewa z najwyższej gałęzi, i tak sąsiedzi dowiadują się, czyja to ziemia."

#: solarui/garden/nature.lua
msgid "Sparrows carry strands of dry grass back to the hedge. Every nest begins as a pile of small errands."
msgstr "Wróble noszą pasma suchej trawy do żywopłotu. Każde gniazdo zaczyna się od stosu drobnych zadań."

#: solarui/garden/nature.lua
msgid "A snail leaves a trail of silver on the stones, and the rain wipes the trail away before supper."
msgstr "Ślimak zostawia na kamieniach srebrny ślad, a deszcz zmywa go przed kolacją."

#: solarui/garden/nature.lua
msgid "Frogs gather in the pond on the first warm nights, and the spawn floats in a clear, trembling cloud."
msgstr "Żaby zbierają się w stawie w pierwsze ciepłe noce, a skrzek unosi się w czystej, drżącej chmurze."

#: solarui/garden/nature.lua
msgid "Narcissus nods in the wind and holds on to the petals through all of April's rain."
msgstr "Narcyz kiwa się na wietrze i trzyma płatki przez cały kwietniowy deszcz."

#: solarui/garden/nature.lua
msgid "At the equinox day and night are almost the same length everywhere on Earth, and from then on the light has the upper hand."
msgstr "W równonoc dzień i noc mają prawie tę samą długość na całej Ziemi, a od tej chwili światło bierze górę."

#: solarui/garden/nature.lua
msgid "At midsummer the sun barely sets in the north, and the last light lingers on the lawn long after supper."
msgstr "W środku lata słońce prawie nie zachodzi na północy, a ostatnie światło długo po kolacji zostaje na trawniku."

#: solarui/garden/nature.lua
msgid "The lily opens in the morning and closes in the afternoon, as regular as a clock with no hands."
msgstr "Lilia otwiera się rano i zamyka po południu, równie regularnie jak zegar bez wskazówek."

#: solarui/garden/nature.lua
msgid "A bee on a flower is doing a day's work. She may visit hundreds of blossoms before she turns for home."
msgstr "Pszczoła na kwiecie wykonuje dniówkę. Może odwiedzić setki kwiatów, zanim zawróci do domu."

#: solarui/garden/nature.lua
msgid "The dragonfly hovers, darts, and returns to the same perch. Each of the four wings can move separately."
msgstr "Ważka zawisa, wystrzela i wraca na to samo miejsce. Każde z czterech skrzydeł porusza się osobno."

#: solarui/garden/nature.lua
msgid "Sunflowers follow the sun when they are young. Once they flower, the big heads settle facing east."
msgstr "Młode słoneczniki podążają za słońcem. Gdy rozkwitną, duże główki zatrzymują się zwrócone ku wschodowi."

#: solarui/garden/nature.lua
msgid "At dusk the moths come out for the flowers that stayed open, and the garden begins the night shift."
msgstr "O zmierzchu ćmy wylatują do kwiatów, które zostały otwarte, a ogród zaczyna nocną zmianę."

#: solarui/garden/nature.lua
msgid "The pond is quietest in the heat of the afternoon. By evening the frogs are ready to sing."
msgstr "Staw jest najcichszy w upale popołudnia. Wieczorem żaby są gotowe do śpiewu."

#: solarui/garden/nature.lua
msgid "A poppy lasts a day or two, but the plant makes dozens of flowers, and thousands of seeds for the years ahead."
msgstr "Mak trwa dzień lub dwa, ale roślina wytwarza dziesiątki kwiatów i tysiące nasion na lata naprzód."

#: solarui/garden/nature.lua
msgid "Shade is a gift in summer. Sit under the maple for ten minutes and notice how much cooler the air feels."
msgstr "Cień w lecie to dar. Posiedź dziesięć minut pod klonem i zauważ, o ile chłodniejsze jest powietrze."

#: solarui/garden/nature.lua
msgid "The ginkgo's leaves are a deep, glossy green now. In autumn they will turn gold and fall almost overnight."
msgstr "Liście miłorzębu są teraz głęboko zielone i lśniące. Jesienią zżółkną i opadną niemal w jedną noc."

#: solarui/garden/nature.lua
msgid "Swifts scream across the sky in the warm evenings. They eat, drink and even sleep on the wing."
msgstr "Jerzyki krzyczą na niebie w ciepłe wieczory. Jedzą, piją, a nawet śpią w locie."

#: solarui/garden/nature.lua
msgid "The bellflower trembles in the lightest breeze, and sheds tiny seeds from holes at the base of each capsule."
msgstr "Dzwonek drży na najlżejszym powiewie i sypie drobne nasiona z otworów u podstawy każdej torebki."

#: solarui/garden/nature.lua
msgid "The maple turns first at the edges. The green fades as the tree takes back what the leaves can give before they fall."
msgstr "Klon zmienia barwę najpierw na brzegach. Zieleń blednie, gdy drzewo odbiera to, co liście mogą dać, zanim opadną."

#: solarui/garden/nature.lua
msgid "Ivy flowers late, in the cool of October, and the bees that are still about are glad of the flowers."
msgstr "Bluszcz kwitnie późno, w chłodzie października, a pszczoły, które jeszcze latają, cieszą się z kwiatów."

#: solarui/garden/nature.lua
msgid "A hedgehog needs to eat well now to last the winter. A pile of leaves in a quiet corner is a good place to sleep."
msgstr "Jeż musi teraz dobrze jeść, by przetrwać zimę. Stos liści w cichym kącie to dobre miejsce do snu."

#: solarui/garden/nature.lua
msgid "The ginkgo drops every leaf within a day or two of the first hard frost, and leaves a golden circle on the ground."
msgstr "Miłorząb zrzuca wszystkie liście w ciągu dnia lub dwóch po pierwszym mocnym przymrozku i zostawia złoty krąg na ziemi."

#: solarui/garden/nature.lua
msgid "Spiders' webs show in the morning mist, every thread strung with a bead of water."
msgstr "Pajęczyny pokazują się w porannej mgle, każda nić nanizana kroplą wody."

#: solarui/garden/nature.lua
msgid "Honesty's flat pods turn silver and papery. Hold one up to the light and the seeds show through."
msgstr "Płaskie strąki miesięcznicy srebrnieją i stają się papierowe. Podnieś jeden do światła, a nasiona prześwitują."

#: solarui/garden/nature.lua
msgid "Geese fly south in loose skeins, calling to each other. Listen on a still evening and you will hear them before you see them."
msgstr "Gęsi lecą na południe w luźnych kluczach, nawołując się nawzajem. Nasłuchuj w cichy wieczór, a usłyszysz je, zanim zobaczysz."

#: solarui/garden/nature.lua
msgid "The robin guards a patch of ground all winter, even from other robins, and sings from that patch in the cold."
msgstr "Rudzik strzeże kawałka ziemi przez całą zimę, nawet przed innymi rudzikami, i śpiewa z tego miejsca w mrozie."

#: solarui/garden/nature.lua
msgid "The first frost does not kill the garden. The frost tells the plants that the time to rest has come."
msgstr "Pierwszy przymrozek nie zabija ogrodu. Przymrozek mówi roślinom, że nadszedł czas odpoczynku."

#: solarui/garden/nature.lua
msgid "Seeds are the garden's savings: tucked into the soil, they wait for the spring to come back."
msgstr "Nasiona to oszczędności ogrodu: schowane w ziemi, czekają na powrót wiosny."

#: solarui/garden/nature.lua
msgid "At the equinox day and night are almost equal. From now on the dark has the upper hand until midwinter."
msgstr "W równonoc dzień i noc są prawie równe. Od teraz ciemność bierze górę aż do środka zimy."

#: solarui/garden/nature.lua
msgid "The pond grows quiet. The frog settles into the mud, and the dragonfly's eggs wait under the water."
msgstr "Staw cichnie. Żaba osiada w mule, a jaja ważki czekają pod wodą."

#: solarui/garden/nature.lua
msgid "The year's shortest day is still a day. After that, the light comes back by a minute at a time."
msgstr "Najkrótszy dzień w roku to wciąż dzień. Potem światło wraca, minuta po minucie."

#: solarui/garden/nature.lua
msgid "The bare maple shows the bones of the tree: every branch that held a leaf in summer, drawn in ink against the sky."
msgstr "Nagi klon pokazuje kości drzewa: każdą gałąź, która latem niosła liść, narysowaną tuszem na niebie."

#: solarui/garden/nature.lua
msgid "A robin puffs up the feathers on a cold morning, and looks twice the size."
msgstr "Rudzik w zimny poranek stroszy pióra i wygląda dwa razy większy."

#: solarui/garden/nature.lua
msgid "Frost writes on the window in ferns, and the ferns in the garden are waiting under the leaves."
msgstr "Mróz pisze na szybie paprociami, a paprocie w ogrodzie czekają pod liśćmi."

#: solarui/garden/nature.lua
msgid "The hedgehog sleeps in a nest of leaves. The heartbeat slows to a fraction of the summer rate, and the hedgehog wakes in spring."
msgstr "Jeż śpi w gnieździe z liści. Tętno zwalnia do ułamka letniego tempa, a wiosną jeż się budzi."

#: solarui/garden/nature.lua
msgid "Snow is a blanket. The soil beneath stays warmer than the air, and the bulbs sleep on."
msgstr "Śnieg to koc. Gleba pod nim jest cieplejsza niż powietrze, a cebulki śpią dalej."

#: solarui/garden/nature.lua
msgid "The crocus corms are under the ground now, small and patient, waiting for the first warm day."
msgstr "Bulwy krokusów są teraz pod ziemią, małe i cierpliwe, i czekają na pierwszy ciepły dzień."

#: solarui/garden/nature.lua
msgid "A fox's tracks cross the frosty lawn in a neat line, four toes and the marks of claws."
msgstr "Ślady lisa przecinają oszroniony trawnik w równej linii: cztery palce i odciski pazurów."

#: solarui/garden/nature.lua
msgid "Ivy berries ripen in the cold, and are one of the last things the birds can find."
msgstr "Jagody bluszczu dojrzewają w zimnie i są jednym z ostatnich pokarmów, jakie ptaki mogą znaleźć."

#: solarui/garden/nature.lua
msgid "Seeds are not dead. They are asleep, and many of them need the cold to wake."
msgstr "Nasiona nie są martwe. Śpią, a wiele z nich potrzebuje zimna, by się obudzić."

#: solarui/garden/nature.lua
msgid "The pond may freeze over, but under the ice the fish drift slowly and the frogs lie in the mud."
msgstr "Staw może zamarznąć, ale pod lodem ryby dryfują powoli, a żaby leżą w mule."

#: solarui/garden/nature.lua
msgid "The first snowdrop is a promise. The plant has been growing under the snow the whole time."
msgstr "Pierwszy przebiśnieg to obietnica. Roślina rosła pod śniegiem przez cały czas."

#: solarui/garden/nature.lua solarui/ui/gardenbook.lua
msgid "From the garden"
msgstr "Z ogrodu"

#: solarui/garden/pet.lua
msgid "New friend"
msgstr "Nowy przyjaciel"

#: solarui/garden/pet.lua
msgid "Friend"
msgstr "Przyjaciel"

#: solarui/garden/pet.lua
msgid "Close friend"
msgstr "Bliski przyjaciel"

#: solarui/garden/pet.lua
msgid "Dear friend"
msgstr "Drogi przyjaciel"

#: solarui/garden/pet.lua
msgid "Old friend"
msgstr "Dawny przyjaciel"

#: solarui/garden/pet.lua
msgid "%s became your companion."
msgstr "Twoim towarzyszem zostaje: %s."

#: solarui/garden/pet.lua
msgid "The bond reached level %d: %s."
msgstr "Więź osiągnęła poziom %d: %s."

#: solarui/garden/pet.lua
msgid "A book was finished together."
msgstr "Wspólnie ukończono książkę."

#: solarui/garden/pet.lua
msgid "%d day of reading in a row."
msgid_plural "%d days of reading in a row."
msgstr[0] "%d dzień czytania z rzędu."
msgstr[1] "%d dni czytania z rzędu."
msgstr[2] "%d dni czytania z rzędu."

#: solarui/garden/pet.lua
msgid "%d days together."
msgstr "%d dni razem."

#: solarui/garden/pet.lua
msgid "%s came back to you."
msgstr "%s wraca do ciebie."

#: solarui/garden/prompts.lua
msgid "Find three leaves with different edges: smooth, toothed and lobed. Lay them side by side."
msgstr "Znajdź trzy liście o różnych brzegach: gładkim, ząbkowanym i klapowanym. Połóż je obok siebie."

#: solarui/garden/prompts.lua
msgid "Step outside around sunrise and count how many different bird songs you can tell apart."
msgstr "Wyjdź na dwór o wschodzie słońca i policz, ile różnych ptasich śpiewów potrafisz rozróżnić."

#: solarui/garden/prompts.lua
msgid "Sow one seed, even in a pot on a windowsill, and water the seed."
msgstr "Zasiej jedno nasiono, choćby w doniczce na parapecie, i podlej je."

#: solarui/garden/prompts.lua
msgid "Find a flower that opened this week. Count the petals, then watch for who visits."
msgstr "Znajdź kwiat, który otworzył się w tym tygodniu. Policz płatki, potem zobacz, kto go odwiedza."

#: solarui/garden/prompts.lua
msgid "Stand under a tree on a breezy day and listen to the leaves."
msgstr "Stań pod drzewem w wietrzny dzień i posłuchaj liści."

#: solarui/garden/prompts.lua
msgid "Walk somewhere you usually ride or drive, and notice what has changed since last week."
msgstr "Przejdź się tam, gdzie zwykle jedziesz, i zauważ, co zmieniło się od zeszłego tygodnia."

#: solarui/garden/prompts.lua
msgid "Turn over a leaf gently and look underneath for tiny eggs or insects, then put the leaf back."
msgstr "Delikatnie odwróć liść i poszukaj pod spodem maleńkich jaj lub owadów, potem odłóż liść na miejsce."

#: solarui/garden/prompts.lua
msgid "Find a place near water and listen for frogs, ducks or running water."
msgstr "Znajdź miejsce przy wodzie i posłuchaj żab, kaczek albo płynącej wody."

#: solarui/garden/prompts.lua
msgid "Smell the ground after rain, then crouch down and look closely at the soil."
msgstr "Powąchaj ziemię po deszczu, potem przykucnij i przyjrzyj się glebie z bliska."

#: solarui/garden/prompts.lua
msgid "Pick a tree you pass every day and find the buds at the end of a twig. Look again in a week."
msgstr "Wybierz drzewo, które mijasz codziennie, i znajdź pąki na końcu gałązki. Spójrz ponownie za tydzień."

#: solarui/garden/prompts.lua
msgid "Sit still for five minutes and count the sounds you hear that people did not make."
msgstr "Posiedź spokojnie pięć minut i policz dźwięki, które słyszysz, a których nie wydali ludzie."

#: solarui/garden/prompts.lua
msgid "Pick up three pieces of litter on a walk and put them in a bin."
msgstr "Podnieś na spacerze trzy śmieci i wrzuć je do kosza."

#: solarui/garden/prompts.lua
msgid "Find a puddle after rain and look at the sky reflected there, then at who comes to drink."
msgstr "Znajdź kałużę po deszczu i spójrz na odbite w niej niebo, potem na tych, którzy przychodzą się napić."

#: solarui/garden/prompts.lua
msgid "Look for the first butterfly of the year and notice the colours of the wings."
msgstr "Wypatruj pierwszego motyla w tym roku i zauważ kolory skrzydeł."

#: solarui/garden/prompts.lua
msgid "the first butterfly"
msgstr "pierwszy motyl"

#: solarui/garden/prompts.lua
msgid "Find a bud that has just burst and look at how the new leaf is folded."
msgstr "Znajdź pąk, który właśnie pękł, i zobacz, jak złożony jest nowy liść."

#: solarui/garden/prompts.lua
msgid "Find moss on a wall or a tree and look at the moss up close, as if the moss were a tiny forest."
msgstr "Znajdź mech na murze lub drzewie i przyjrzyj mu się z bliska, jakby był malutkim lasem."

#: solarui/garden/prompts.lua
msgid "Look at the light through new leaves and notice how green the light has become."
msgstr "Spójrz na światło przez młode liście i zauważ, jak zielone się stało."

#: solarui/garden/prompts.lua
msgid "Find a daisy and see whether the flower closes towards dusk."
msgstr "Znajdź stokrotkę i zobacz, czy kwiat zamyka się ku wieczorowi."

#: solarui/garden/prompts.lua
msgid "Look for a bee at a flower early in the day, when the bees are slow with cold."
msgstr "Poszukaj pszczoły na kwiecie wcześnie rano, gdy pszczoły są jeszcze powolne od zimna."

#: solarui/garden/prompts.lua
msgid "the first bee"
msgstr "pierwsza pszczoła"

#: solarui/garden/prompts.lua
msgid "Watch a hedge from a distance for a bird carrying twigs, and leave any nest alone."
msgstr "Obserwuj z daleka żywopłot, czy ptak nie niesie gałązek, i zostaw wszelkie gniazdo w spokoju."

#: solarui/garden/prompts.lua
msgid "Listen for a bird singing before dawn, and count the singers."
msgstr "Nasłuchuj ptaka śpiewającego przed świtem i policz śpiewaków."

#: solarui/garden/prompts.lua
msgid "Listen to rain on leaves, on a roof and on the ground, and notice how each sounds different."
msgstr "Posłuchaj deszczu na liściach, na dachu i na ziemi i zauważ, jak każdy brzmi inaczej."

#: solarui/garden/prompts.lua
msgid "Stand quietly near blossom and listen for the buzz of insects."
msgstr "Stań cicho przy kwitnących drzewach i posłuchaj brzęczenia owadów."

#: solarui/garden/prompts.lua
msgid "Listen to the wind in new leaves, and compare the sound with the wind in bare branches."
msgstr "Posłuchaj wiatru w młodych liściach i porównaj ten dźwięk z wiatrem w nagich gałęziach."

#: solarui/garden/prompts.lua
msgid "Listen for a woodpecker drumming on a tree."
msgstr "Nasłuchuj dzięcioła bębniącego w drzewo."

#: solarui/garden/prompts.lua
msgid "Listen at dusk for the last bird to stop singing."
msgstr "Nasłuchuj o zmierzchu ostatniego ptaka, który przestaje śpiewać."

#: solarui/garden/prompts.lua
msgid "Listen at a pond or a ditch for the first frog calling, and remember the day."
msgstr "Posłuchaj nad stawem lub rowem pierwszej żaby i zapamiętaj ten dzień."

#: solarui/garden/prompts.lua
msgid "the first frog calling"
msgstr "pierwsza żaba"

#: solarui/garden/prompts.lua
msgid "Listen at a hedge for the rustle and chirps of birds looking for nest material."
msgstr "Posłuchaj przy żywopłocie szelestu i ćwierkania ptaków szukających materiału na gniazdo."

#: solarui/garden/prompts.lua
msgid "Plant a seed or a bulb in a pot and write the date on a label beside the pot."
msgstr "Posadź nasiono albo cebulkę w doniczce i napisz datę na etykiecie obok doniczki."

#: solarui/garden/prompts.lua
msgid "Take your book outside and read one page under the open sky."
msgstr "Zabierz książkę na dwór i przeczytaj jedną stronę pod otwartym niebem."

#: solarui/garden/prompts.lua
msgid "Walk a path near where you live that you have never taken."
msgstr "Przejdź się ścieżką w pobliżu domu, której nigdy nie szedłeś."

#: solarui/garden/prompts.lua
msgid "Water a plant outdoors or on a sill and watch the water sink into the soil."
msgstr "Podlej roślinę na dworze albo na parapecie i patrz, jak woda wsiąka w ziemię."

#: solarui/garden/prompts.lua
msgid "Put out a bowl of water for the birds and keep the bowl full for a week."
msgstr "Wystaw miskę wody dla ptaków i dbaj, by była pełna przez tydzień."

#: solarui/garden/prompts.lua
msgid "Take a photograph of the same tree each week, starting now."
msgstr "Fotografuj to samo drzewo co tydzień, zaczynając od dziś."

#: solarui/garden/prompts.lua
msgid "Spend a quarter of an hour outside without your phone."
msgstr "Spędź kwadrans na dworze bez telefonu."

#: solarui/garden/prompts.lua
msgid "Sit on the ground and look closely at everything at the height of your hand."
msgstr "Usiądź na ziemi i przyjrzyj się dokładnie wszystkiemu na wysokości swojej dłoni."

#: solarui/garden/prompts.lua
msgid "Take a deep breath outside and name three smells."
msgstr "Weź głęboki oddech na dworze i nazwij trzy zapachy."

#: solarui/garden/prompts.lua
msgid "Find a flower with a bee on the petals and watch how long the bee stays and where the bee goes next."
msgstr "Znajdź kwiat z pszczołą na płatkach i zobacz, jak długo pszczoła zostaje i dokąd leci dalej."

#: solarui/garden/prompts.lua
msgid "Listen at dusk for crickets, grasshoppers or birds settling for the night."
msgstr "Nasłuchuj o zmierzchu świerszczy, koników polnych albo ptaków układających się do snu."

#: solarui/garden/prompts.lua
msgid "Sit in the shade for ten minutes without your phone and notice everything that moves."
msgstr "Posiedź w cieniu dziesięć minut bez telefonu i zauważ wszystko, co się rusza."

#: solarui/garden/prompts.lua
msgid "Find three kinds of seeds and compare how each one is made to travel."
msgstr "Znajdź trzy rodzaje nasion i porównaj, jak każde jest zbudowane do podróży."

#: solarui/garden/prompts.lua
msgid "Close your eyes in a park or garden and listen for the nearest bird, then the next nearest."
msgstr "Zamknij oczy w parku albo ogrodzie i posłuchaj najbliższego ptaka, potem następnego."

#: solarui/garden/prompts.lua
msgid "Leave a shallow dish of water out for birds and insects, and see who comes."
msgstr "Zostaw płytką miseczkę z wodą dla ptaków i owadów i zobacz, kto przyjdzie."

#: solarui/garden/prompts.lua
msgid "Look early in the morning for a spider's web, when the dew makes every thread show."
msgstr "Poszukaj wcześnie rano pajęczyny, gdy rosa wydobywa każdą nić."

#: solarui/garden/prompts.lua
msgid "Stand still near flowers and listen for the hum of bees."
msgstr "Stań nieruchomo przy kwiatach i posłuchaj brzęczenia pszczół."

#: solarui/garden/prompts.lua
msgid "Lie on the grass and look up through the branches of a tree for a few minutes."
msgstr "Połóż się na trawie i patrz przez kilka minut w górę przez gałęzie drzewa."

#: solarui/garden/prompts.lua
msgid "Watch the sky at dusk for swifts, swallows, bats or moths."
msgstr "Obserwuj o zmierzchu niebo w poszukiwaniu jerzyków, jaskółek, nietoperzy albo ciem."

#: solarui/garden/prompts.lua
msgid "Find the tallest tree near you and listen to the wind in the top."
msgstr "Znajdź najwyższe drzewo w pobliżu i posłuchaj wiatru w jego koronie."

#: solarui/garden/prompts.lua
msgid "Walk barefoot on grass, sand or soil for a few minutes, if the ground is safe."
msgstr "Przejdź boso po trawie, piasku albo ziemi przez kilka minut, jeśli grunt jest bezpieczny."

#: solarui/garden/prompts.lua
msgid "Find a butterfly resting with closed wings and look at the underside, then wait for the wings to open."
msgstr "Znajdź motyla odpoczywającego ze złożonymi skrzydłami, obejrzyj spód i poczekaj, aż skrzydła się otworzą."

#: solarui/garden/prompts.lua
msgid "Look at the sky and name the clouds: high wisps, fluffy heaps or a flat grey sheet."
msgstr "Spójrz na niebo i nazwij chmury: wysokie smugi, puszyste stosy albo płaską szarą płachtę."

#: solarui/garden/prompts.lua
msgid "Mark the shadow of a tree at noon and again two hours later, and see how far the shadow has moved."
msgstr "Zaznacz cień drzewa w południe i jeszcze raz dwie godziny później, i zobacz, jak daleko cień się przesunął."

#: solarui/garden/prompts.lua
msgid "Look closely at a daisy or a dandelion and see that the one flower is really many small flowers."
msgstr "Przyjrzyj się dokładnie stokrotce lub mniszkowi i zobacz, że jeden kwiat to w istocie wiele małych kwiatów."

#: solarui/garden/prompts.lua
msgid "Find a snail or a slug on a damp morning and follow the trail."
msgstr "Znajdź ślimaka w wilgotny poranek i idź jego śladem."

#: solarui/garden/prompts.lua
msgid "Find the spot where a flower has fallen and a fruit is starting to form."
msgstr "Znajdź miejsce, gdzie kwiat opadł i zaczyna się tworzyć owoc."

#: solarui/garden/prompts.lua
msgid "Watch an ant trail for a minute and see what the ants are carrying."
msgstr "Obserwuj ścieżkę mrówek przez minutę i zobacz, co mrówki niosą."

#: solarui/garden/prompts.lua
msgid "Look for the first ripe berry of the summer and remember the day."
msgstr "Wypatruj pierwszej dojrzałej jagody lata i zapamiętaj ten dzień."

#: solarui/garden/prompts.lua
msgid "the first ripe berry"
msgstr "pierwsza dojrzała jagoda"

#: solarui/garden/prompts.lua
msgid "Listen to a hot afternoon: what has gone quiet, and what has not?"
msgstr "Posłuchaj gorącego popołudnia: co ucichło, a co nie?"

#: solarui/garden/prompts.lua
msgid "Listen for a bird that sounds like a question, and try to find the singer."
msgstr "Posłuchaj ptaka, który brzmi jak pytanie, i spróbuj znaleźć śpiewaka."

#: solarui/garden/prompts.lua
msgid "Listen to water: a stream, a fountain, a tap or a puddle. Which is the gentlest?"
msgstr "Posłuchaj wody: strumienia, fontanny, kranu albo kałuży. Która jest najdelikatniejsza?"

#: solarui/garden/prompts.lua
msgid "Sit near a hedge and listen for the small rustles of wrens and sparrows."
msgstr "Usiądź przy żywopłocie i posłuchaj cichych szelestów strzyżyków i wróbli."

#: solarui/garden/prompts.lua
msgid "Listen for the first swift screaming overhead, and remember the day."
msgstr "Nasłuchuj pierwszego jerzyka krzyczącego nad głową i zapamiętaj ten dzień."

#: solarui/garden/prompts.lua
msgid "the first swift"
msgstr "pierwszy jerzyk"

#: solarui/garden/prompts.lua
msgid "Listen to a storm arriving: the wind first, then the hush, then the rain."
msgstr "Posłuchaj nadchodzącej burzy: najpierw wiatru, potem ciszy, potem deszczu."

#: solarui/garden/prompts.lua
msgid "Listen at the edge of a field to the dry whisper of long grass."
msgstr "Posłuchaj na skraju pola suchego szeptu wysokiej trawy."

#: solarui/garden/prompts.lua
msgid "Listen at night through an open window to the sounds of the dark."
msgstr "Posłuchaj nocą przez otwarte okno odgłosów ciemności."

#: solarui/garden/prompts.lua
msgid "Water a thirsty plant in the cool of the evening, and watch the leaves lift."
msgstr "Podlej spragnioną roślinę w chłodzie wieczoru i patrz, jak liście się unoszą."

#: solarui/garden/prompts.lua
msgid "Pick up a smooth stone and carry the stone for a day, then return the stone to where you found the stone."
msgstr "Podnieś gładki kamień, noś go przez dzień, potem odłóż go tam, gdzie go znalazłeś."

#: solarui/garden/prompts.lua
msgid "Eat something outside, a piece of fruit if you can, and notice every taste."
msgstr "Zjedz coś na dworze, najlepiej owoc, i zauważ każdy smak."

#: solarui/garden/prompts.lua
msgid "Leave a patch of lawn unmown or a corner of a window box wild, and see who moves in."
msgstr "Zostaw kawałek trawnika nieskoszony albo kąt skrzynki na parapecie dziki i zobacz, kto się wprowadzi."

#: solarui/garden/prompts.lua
msgid "Take your book outside and read in the shade for twenty minutes."
msgstr "Zabierz książkę na dwór i czytaj w cieniu przez dwadzieścia minut."

#: solarui/garden/prompts.lua
msgid "Go out an hour before sunset and walk until the light turns gold."
msgstr "Wyjdź na godzinę przed zachodem słońca i idź, aż światło zezłoci się."

#: solarui/garden/prompts.lua
msgid "Sit by water and put a hand in the water."
msgstr "Usiądź przy wodzie i zanurz w niej rękę."

#: solarui/garden/prompts.lua
msgid "Press a flower or a leaf between the pages of a heavy book."
msgstr "Wsusz kwiat albo liść między kartkami ciężkiej książki."

#: solarui/garden/prompts.lua
msgid "Draw a plant you can see, even badly, and put the date on the drawing."
msgstr "Narysuj roślinę, którą widzisz, choćby niezdarnie, i wpisz datę na rysunku."

#: solarui/garden/prompts.lua
msgid "Gather leaves of three colours and set them in a line from green to red."
msgstr "Zbierz liście trzech kolorów i ułóż je w rząd od zieleni do czerwieni."

#: solarui/garden/prompts.lua
msgid "Listen for geese, starlings or other flocks passing overhead."
msgstr "Nasłuchuj gęsi, szpaków albo innych stad przelatujących nad głową."

#: solarui/garden/prompts.lua
msgid "Leave a pile of leaves in a quiet corner, where a hedgehog or a beetle might shelter."
msgstr "Zostaw stos liści w cichym kącie, gdzie mógłby schronić się jeż albo chrząszcz."

#: solarui/garden/prompts.lua
msgid "Look for a bird eating berries and notice which berries are chosen."
msgstr "Poszukaj ptaka zjadającego jagody i zauważ, które jagody wybiera."

#: solarui/garden/prompts.lua
msgid "Walk on dry leaves and listen to how each kind crunches."
msgstr "Idź po suchych liściach i posłuchaj, jak każdy rodzaj chrzęści."

#: solarui/garden/prompts.lua
msgid "Collect three seeds or nuts, such as acorns, conkers or maple keys, and look at how each is made."
msgstr "Zbierz trzy nasiona lub orzechy, jak żołędzie, kasztany albo skrzydlaki klonu, i zobacz, jak każde jest zbudowane."

#: solarui/garden/prompts.lua
msgid "Look for mushrooms in the leaf litter. Look closely, and do not touch or taste."
msgstr "Poszukaj grzybów w ściółce liści. Patrz uważnie, nie dotykaj i nie próbuj."

#: solarui/garden/prompts.lua
msgid "On a still evening, listen for an owl or a robin singing in the dusk."
msgstr "W cichy wieczór nasłuchuj sowy albo rudzika śpiewającego o zmierzchu."

#: solarui/garden/prompts.lua
msgid "Watch a sunset and notice how early the sun goes down now."
msgstr "Obejrzyj zachód słońca i zauważ, jak wcześnie słońce zachodzi teraz."

#: solarui/garden/prompts.lua
msgid "Find one seed that flies on the wind, one that sticks to clothes and one that animals eat."
msgstr "Znajdź jedno nasiono, które leci z wiatrem, jedno, które czepia się ubrań, i jedno, które zjadają zwierzęta."

#: solarui/garden/prompts.lua
msgid "Stand under a tree as the leaves fall and listen for the small sound of each one landing."
msgstr "Stań pod drzewem, gdy liście opadają, i nasłuchuj cichego dźwięku każdego lądującego liścia."

#: solarui/garden/prompts.lua
msgid "Notice which trees have kept their leaves and which have let them go, and think about why."
msgstr "Zauważ, które drzewa zachowały liście, a które je puściły, i pomyśl, dlaczego."

#: solarui/garden/prompts.lua
msgid "Find a spider's web with the spider still at home, and look at how the threads are laid."
msgstr "Znajdź pajęczynę z pająkiem w domu i zobacz, jak ułożone są nici."

#: solarui/garden/prompts.lua
msgid "Look at a leaf that is half green and half red, and find where the colours meet."
msgstr "Spójrz na liść pół zielony, pół czerwony i znajdź miejsce, gdzie barwy się spotykają."

#: solarui/garden/prompts.lua
msgid "Look at what the first frost or the first fog of the season has covered, and remember the day."
msgstr "Spójrz na to, co pierwszy przymrozek albo pierwsza mgła sezonu pokryły, i zapamiętaj ten dzień."

#: solarui/garden/prompts.lua
msgid "the first frost"
msgstr "pierwszy przymrozek"

#: solarui/garden/prompts.lua
msgid "Look for a squirrel or a jay burying food, and notice where."
msgstr "Wypatruj wiewiórki albo sójki zakopującej jedzenie i zauważ gdzie."

#: solarui/garden/prompts.lua
msgid "Look at how high the midday sun is, and compare the height with the summer sun."
msgstr "Zobacz, jak wysoko jest południowe słońce, i porównaj tę wysokość z letnim słońcem."

#: solarui/garden/prompts.lua
msgid "Find a hedge full of berries and count the colours."
msgstr "Znajdź żywopłot pełen jagód i policz kolory."

#: solarui/garden/prompts.lua
msgid "Look up at a flock leaving or arriving, and count them in tens."
msgstr "Spójrz w górę na stado, które odlatuje lub przylatuje, i licz je dziesiątkami."

#: solarui/garden/prompts.lua
msgid "Listen for an owl or another night bird after dark."
msgstr "Nasłuchuj po zmroku sowy albo innego nocnego ptaka."

#: solarui/garden/prompts.lua
msgid "Listen to the wind shaking seed pods and dry stems."
msgstr "Posłuchaj wiatru wstrząsającego strąkami i suchymi łodygami."

#: solarui/garden/prompts.lua
msgid "Listen for the last cricket of the year, and remember the day."
msgstr "Nasłuchuj ostatniego świerszcza w tym roku i zapamiętaj ten dzień."

#: solarui/garden/prompts.lua
msgid "the last cricket"
msgstr "ostatni świerszcz"

#: solarui/garden/prompts.lua
msgid "Listen for the call of a bird that has just arrived for the winter."
msgstr "Nasłuchuj głosu ptaka, który dopiero co przybył na zimę."

#: solarui/garden/prompts.lua
msgid "Listen to rain on fallen leaves."
msgstr "Posłuchaj deszczu na opadłych liściach."

#: solarui/garden/prompts.lua
msgid "Listen to your own steps on a muddy path, then on a dry one."
msgstr "Posłuchaj własnych kroków na błotnistej ścieżce, a potem na suchej."

#: solarui/garden/prompts.lua
msgid "Listen at dusk as the garden gets ready for night, and notice what goes quiet first."
msgstr "Posłuchaj o zmierzchu, jak ogród szykuje się do nocy, i zauważ, co cichnie najpierw."

#: solarui/garden/prompts.lua
msgid "Stand still and follow the faintest sound you can hear for a full minute."
msgstr "Stań nieruchomo i podążaj za najcichszym dźwiękiem, jaki słyszysz, przez całą minutę."

#: solarui/garden/prompts.lua
msgid "Rake a few leaves into a heap and walk through the heap."
msgstr "Zgrab kilka liści w stos i przejdź przez ten stos."

#: solarui/garden/prompts.lua
msgid "Plant a bulb for the spring, and mark the place."
msgstr "Posadź cebulkę na wiosnę i zaznacz to miejsce."

#: solarui/garden/prompts.lua
msgid "Save the seeds of a flower you like in a paper envelope, and write the name on the envelope."
msgstr "Zachowaj nasiona kwiatu, który lubisz, w papierowej kopercie i napisz na niej nazwę."

#: solarui/garden/prompts.lua
msgid "Take a walk after rain with a bag for leaves and seeds."
msgstr "Wybierz się na spacer po deszczu z torbą na liście i nasiona."

#: solarui/garden/prompts.lua
msgid "Note the date the first tree in your street turns."
msgstr "Zanotuj datę, kiedy pierwsze drzewo na twojej ulicy zmienia barwę."

#: solarui/garden/prompts.lua
msgid "Take your book outside and read in the last warm sun."
msgstr "Zabierz książkę na dwór i czytaj w ostatnim ciepłym słońcu."

#: solarui/garden/prompts.lua
msgid "Buy or gather something of the season, such as apples, pumpkins or nuts, and taste the first bite outdoors."
msgstr "Kup albo zbierz coś sezonowego, jak jabłka, dynie albo orzechy, i skosztuj pierwszego kęsa na dworze."

#: solarui/garden/prompts.lua
msgid "Cut back what has finished in your pots or window box, and leave what is still flowering."
msgstr "Przytnij to, co przekwitło w doniczkach albo skrzynce, a zostaw to, co jeszcze kwitnie."

#: solarui/garden/prompts.lua
msgid "Go outside at dusk with a hot drink and watch the light go."
msgstr "Wyjdź o zmierzchu z gorącym napojem i patrz, jak gaśnie światło."

#: solarui/garden/prompts.lua
msgid "Take a leaf from a tree and find out the name of the tree."
msgstr "Weź liść z drzewa i dowiedz się, jak drzewo się nazywa."

#: solarui/garden/prompts.lua
msgid "Look for tracks in frost, mud or snow, and follow one set for as far as the tracks go."
msgstr "Poszukaj śladów w szronie, błocie albo śniegu i podążaj za jednym szlakiem tak daleko, jak sięgają ślady."

#: solarui/garden/prompts.lua
msgid "Stand outside after snow and listen to how quiet the world has become."
msgstr "Stań na dworze po śniegu i posłuchaj, jak cicho zrobiło się na świecie."

#: solarui/garden/prompts.lua
msgid "Hang up food for the birds, or put out fresh water, and watch who comes."
msgstr "Powieś jedzenie dla ptaków albo wystaw świeżą wodę i zobacz, kto przyjdzie."

#: solarui/garden/prompts.lua
msgid "Find the bud at the end of a bare branch, small and tightly closed."
msgstr "Znajdź pąk na końcu nagiej gałęzi, mały i szczelnie zamknięty."

#: solarui/garden/prompts.lua
msgid "Listen for a robin or a wren singing in the cold."
msgstr "Nasłuchuj rudzika albo strzyżyka śpiewającego w mrozie."

#: solarui/garden/prompts.lua
msgid "Go out on a clear night, let your eyes adjust for ten minutes, and find one constellation."
msgstr "Wyjdź w pogodną noc, pozwól oczom przywyknąć przez dziesięć minut i znajdź jeden gwiazdozbiór."

#: solarui/garden/prompts.lua
msgid "Find something green in the middle of winter, and ask what the plant is doing."
msgstr "Znajdź coś zielonego w środku zimy i zapytaj, co ta roślina robi."

#: solarui/garden/prompts.lua
msgid "Listen to your own footsteps on frost, leaves or snow."
msgstr "Posłuchaj własnych kroków na szronie, liściach albo śniegu."

#: solarui/garden/prompts.lua
msgid "Walk for twenty minutes in daylight, however cold, and notice how long the shadows are."
msgstr "Spaceruj dwadzieścia minut za dnia, choćby było zimno, i zauważ, jak długie są cienie."

#: solarui/garden/prompts.lua
msgid "Count the birds in a hedge or at a feeder for five minutes."
msgstr "Policz ptaki w żywopłocie albo przy karmniku przez pięć minut."

#: solarui/garden/prompts.lua
msgid "Stand by a frozen puddle or pond and listen for the ice creaking."
msgstr "Stań przy zamarzniętej kałuży albo stawie i posłuchaj skrzypienia lodu."

#: solarui/garden/prompts.lua
msgid "Look for the first snowdrop or catkin of the year, and remember the date."
msgstr "Wypatruj pierwszego przebiśniegu albo bazi w tym roku i zapamiętaj datę."

#: solarui/garden/prompts.lua
msgid "the first snowdrop or catkin"
msgstr "pierwszy przebiśnieg albo bazia"

#: solarui/garden/prompts.lua
msgid "Look at your breath in the cold air and watch where the breath goes."
msgstr "Spójrz na swój oddech w zimnym powietrzu i zobacz, dokąd leci."

#: solarui/garden/prompts.lua
msgid "Find an icicle or a pattern of frost and look closely at the shape."
msgstr "Znajdź sopel albo wzór z szronu i przyjrzyj się dokładnie kształtowi."

#: solarui/garden/prompts.lua
msgid "Look for a bird's nest in a bare tree, where the nest can now be seen, and leave the nest alone."
msgstr "Poszukaj ptasiego gniazda na nagim drzewie, gdzie teraz je widać, i zostaw gniazdo w spokoju."

#: solarui/garden/prompts.lua
msgid "Look at the stars and find the brightest one. Does the star twinkle?"
msgstr "Spójrz na gwiazdy i znajdź najjaśniejszą. Czy gwiazda migocze?"

#: solarui/garden/prompts.lua
msgid "Watch a sunrise or a sunset and notice where the sun comes up or goes down compared with last month."
msgstr "Obejrzyj wschód albo zachód słońca i zauważ, gdzie słońce wschodzi lub zachodzi w porównaniu z zeszłym miesiącem."

#: solarui/garden/prompts.lua
msgid "Find a plant that has kept the berries and see who comes to eat them."
msgstr "Znajdź roślinę, która zachowała jagody, i zobacz, kto przychodzi je zjeść."

#: solarui/garden/prompts.lua
msgid "Listen for the sound of snow falling, or for the quiet that comes with the snow."
msgstr "Posłuchaj dźwięku padającego śniegu albo ciszy, jaką przynosi śnieg."

#: solarui/garden/prompts.lua
msgid "Listen for a bird calling on a frosty morning and try to find the singer."
msgstr "Nasłuchuj ptaka nawołującego w mroźny poranek i spróbuj znaleźć śpiewaka."

#: solarui/garden/prompts.lua
msgid "Listen for geese or other winter birds overhead at dusk."
msgstr "Nasłuchuj o zmierzchu gęsi albo innych zimowych ptaków nad głową."

#: solarui/garden/prompts.lua
msgid "Listen to the wind on a cold night from indoors, and think where the wind has been."
msgstr "Posłuchaj z wnętrza domu wiatru w zimną noc i pomyśl, gdzie wiatr był."

#: solarui/garden/prompts.lua
msgid "Listen to wet leaves underfoot, and compare them with dry ones."
msgstr "Posłuchaj mokrych liści pod stopami i porównaj je z suchymi."

#: solarui/garden/prompts.lua
msgid "Listen for tits and finches moving through the garden in a flock."
msgstr "Nasłuchuj bogatek i zięb wędrujących przez ogród stadem."

#: solarui/garden/prompts.lua
msgid "Listen at a window to the dawn and notice how late the first song starts now."
msgstr "Posłuchaj przy oknie świtu i zauważ, jak późno zaczyna się teraz pierwsza pieśń."

#: solarui/garden/prompts.lua
msgid "Listen for the first song of any bird other than a robin, and remember the day."
msgstr "Nasłuchuj pierwszej pieśni jakiegokolwiek ptaka poza rudzikiem i zapamiętaj ten dzień."

#: solarui/garden/prompts.lua
msgid "the first new birdsong"
msgstr "pierwsza nowa ptasia pieśń"

#: solarui/garden/prompts.lua
msgid "Fill a bird feeder and keep the feeder full for a week."
msgstr "Napełnij karmnik dla ptaków i dbaj, by był pełen przez tydzień."

#: solarui/garden/prompts.lua
msgid "Press a finger into frost or snow and look at the mark left behind."
msgstr "Wciśnij palec w szron albo śnieg i spójrz na zostawiony ślad."

#: solarui/garden/prompts.lua
msgid "Take your book outside, wrapped up warm, and read one page in the cold."
msgstr "Zabierz książkę na dwór, ciepło opatulony, i przeczytaj jedną stronę w zimnie."

#: solarui/garden/prompts.lua
msgid "Sow a seed on a windowsill and watch for the first green."
msgstr "Zasiej nasiono na parapecie i wypatruj pierwszej zieleni."

#: solarui/garden/prompts.lua
msgid "Put a pine cone, a seed head or a twig on a windowsill and draw the shape."
msgstr "Połóż na parapecie szyszkę, kulkę z nasionami albo gałązkę i narysuj jej kształt."

#: solarui/garden/prompts.lua
msgid "Go out at first light and be there for the sunrise."
msgstr "Wyjdź o pierwszym świetle i bądź tam na wschód słońca."

#: solarui/garden/prompts.lua
msgid "Walk to a place where you can see far, and look at the shape of the land."
msgstr "Przejdź się do miejsca, z którego widać daleko, i przyjrzyj się kształtowi ziemi."

#: solarui/garden/prompts.lua
msgid "Warm your hands round a hot drink while standing outside."
msgstr "Ogrzej dłonie o gorący napój, stojąc na dworze."

#: solarui/garden/prompts.lua
msgid "Check on a plant you left outside and look for green at the base."
msgstr "Sprawdź roślinę, którą zostawiłeś na dworze, i poszukaj zieleni u podstawy."

#: solarui/garden/prompts.lua
msgid "Leave a shallow dish of water out on a freezing day and see how thick the ice is in the morning."
msgstr "Zostaw w mroźny dzień płytką miseczkę z wodą i zobacz rano, jak gruby jest lód."

#: solarui/garden/prompts.lua
msgid "Take a photograph of a tree in winter, and take the same one again in summer."
msgstr "Sfotografuj drzewo zimą i zrób to samo zdjęcie latem."

#: solarui/garden/season.lua
msgid "Spring"
msgstr "Wiosna"

#: solarui/garden/season.lua
msgid "Summer"
msgstr "Lato"

#: solarui/garden/season.lua
msgid "Autumn"
msgstr "Jesień"

#: solarui/garden/season.lua
msgid "Winter"
msgstr "Zima"

#: solarui/garden/season.lua
msgid "Asleep in %s."
msgstr "Śpi w: %s."

#: solarui/garden/state.lua
msgid "From your garden: %s. %s"
msgstr "Z twojego ogrodu: %s. %s"

#: solarui/garden/state.lua
msgid "From your garden: %s. Can you find a real one outdoors this week?"
msgstr "Z twojego ogrodu: %s. Czy w tym tygodniu znajdziesz prawdziwego na dworze?"

#: solarui/garden/visitors.lua
msgid "Lives in the garden from the start."
msgstr "Mieszka w ogrodzie od początku."

#: solarui/garden/visitors.lua
msgid "Have %d plants in bloom."
msgstr "Miej %d kwitnących roślin."

#: solarui/garden/visitors.lua
msgid "Read %d pages in the early morning."
msgstr "Przeczytaj %d stron wcześnie rano."

#: solarui/garden/visitors.lua
msgid "Read %d pages late at night."
msgstr "Przeczytaj %d stron późno w nocy."

#: solarui/garden/visitors.lua
msgid "Finish %d books."
msgstr "Ukończ %d książek."

#: solarui/garden/visitors.lua
msgid "Read %d days in a row."
msgstr "Czytaj przez %d dni z rzędu."

#: solarui/garden/visitors.lua
msgid "a bud forms"
msgstr "zawiązuje się pąk"

#: solarui/garden/visitors.lua
msgid "the flower opens"
msgstr "kwiat się otwiera"

#: solarui/garden/visitors.lua
msgid "Grow the %s until %s."
msgstr "Hoduj: %s, aż do: %s."

#: solarui/garden/weather.lua
msgid "Clear"
msgstr "Pogodnie"

#: solarui/garden/weather.lua
msgid "Cloudy"
msgstr "Pochmurno"

#: solarui/garden/weather.lua
msgid "Rain"
msgstr "Deszcz"

#: solarui/garden/weather.lua
msgid "Snow"
msgstr "Śnieg"

#: solarui/garden/weather.lua
msgid "Mist"
msgstr "Mgła"

#: solarui/garden/web.lua
msgid "Crocuses flower in late winter and give bees one of their first meals of the year."
msgstr "Krokusy kwitną pod koniec zimy i dają pszczołom jeden z pierwszych posiłków w roku."

#: solarui/garden/web.lua
msgid "Dandelions open early in spring, when few other flowers do, and feed bees after the winter."
msgstr "Mlecze otwierają się wcześnie wiosną, gdy mało innych kwiatów to robi, i karmią pszczoły po zimie."

#: solarui/garden/web.lua
msgid "Ivy flowers in autumn, when most other flowers are over, and bees and hoverflies feed on the flowers."
msgstr "Bluszcz kwitnie jesienią, gdy większość innych kwiatów już przekwitła, a pszczoły i bzygi żywią się jego kwiatami."

#: solarui/garden/web.lua
msgid "Bees gather pollen and nectar from the many small flowers of a sunflower head."
msgstr "Pszczoły zbierają pyłek i nektar z wielu małych kwiatków główki słonecznika."

#: solarui/garden/web.lua
msgid "Butterflies sip nectar from harebells and other summer flowers."
msgstr "Motyle sączą nektar z dzwonków i innych letnich kwiatów."

#: solarui/garden/web.lua
msgid "Butterflies drink nectar from irises and look for warm, sheltered beds."
msgstr "Motyle piją nektar z kosaćców i szukają ciepłych, osłoniętych grządek."

#: solarui/garden/web.lua
msgid "Roses attract aphids, and ladybirds and their larvae eat the aphids."
msgstr "Róże przyciągają mszyce, a biedronki i ich larwy zjadają mszyce."

#: solarui/garden/web.lua
msgid "Strongly scented flowers that stay open into the evening feed the moths that come after the bees have gone."
msgstr "Mocno pachnące kwiaty, które zostają otwarte do wieczora, karmią ćmy, które przylatują, gdy pszczoły już odejdą."

#: solarui/garden/web.lua
msgid "Bees work the flowers by day and moths by night, so the flowers are visited round the clock."
msgstr "Pszczoły pracują przy kwiatach za dnia, a ćmy nocą, więc kwiaty są odwiedzane całą dobę."

#: solarui/garden/web.lua
msgid "Dragonflies rest on lily leaves, and lay their eggs in the water among the stems."
msgstr "Ważki odpoczywają na liściach lilii i składają jaja w wodzie między łodygami."

#: solarui/garden/web.lua
msgid "Frogs sit on lily leaves, with only the face above the water."
msgstr "Żaby siedzą na liściach lilii, z samą twarzą nad wodą."

#: solarui/garden/web.lua
msgid "Dragonfly larvae eat tadpoles, and frogs catch adult dragonflies."
msgstr "Larwy ważek jedzą kijanki, a żaby łapią dorosłe ważki."

#: solarui/garden/web.lua
msgid "Lily leaves shade the pond, which keeps the water cooler for the fish."
msgstr "Liście lilii cienią staw, dzięki czemu woda jest chłodniejsza dla ryb."

#: solarui/garden/web.lua
msgid "Hedgehogs eat snails and slugs, and gardens with hedgehogs have fewer of them."
msgstr "Jeże jedzą ślimaki i ślimaki nagie, więc w ogrodach z jeżami jest ich mniej."

#: solarui/garden/web.lua
msgid "Ivy berries ripen in late winter and feed birds when other food is scarce."
msgstr "Jagody bluszczu dojrzewają pod koniec zimy i karmią ptaki, gdy brakuje innego pożywienia."

#: solarui/garden/web.lua
msgid "Squash flowers open early in the morning, and bees gather their pollen before the heat of the day."
msgstr "Kwiaty dyni otwierają się wcześnie rano, a pszczoły zbierają ich pyłek przed upałem dnia."

#: solarui/garden/web.lua
msgid "Peafowl eat seeds, and will take the seeds from the heads of fallen sunflowers."
msgstr "Pawie jedzą nasiona i zabierają je z główek opadłych słoneczników."

#: solarui/garden/web.lua
msgid "She watches the robin for hours, and answers the robin's song with a chattering version of her own."
msgstr "Godzinami obserwuje rudzika i odpowiada na jego pieśń własną, szczebiotliwą wersją."

#: solarui/garden/web.lua
msgid "The peacock believes he is the most magnificent creature in the garden. Nobody has told him about Yüzsüz yet."
msgstr "Paw uważa się za najwspanialsze stworzenie w ogrodzie. Nikt jeszcze nie powiedział mu o Yüzsüz."

#: solarui/garden/yuzsuz.lua
msgid "Salami"
msgstr "Salami"

#: solarui/garden/yuzsuz.lua
msgid "her favourite"
msgstr "jej ulubione"

#: solarui/garden/yuzsuz.lua
