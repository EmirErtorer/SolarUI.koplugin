msgstr[0] "%d książka zaindeksowana; odbuduj po skopiowaniu książek"
msgstr[1] "%d książki zaindeksowane; odbuduj po skopiowaniu książek"
msgstr[2] "%d książek zaindeksowanych; odbuduj po skopiowaniu książek"

#: solarui/screens/settings.lua
