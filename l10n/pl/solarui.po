msgstr "Ślimak winniczek"

#: solarui/garden/cast.lua
msgid "tender leaves"
msgstr "młode liście"

#: solarui/garden/cast.lua
msgid "Swallowtail"
msgstr "Paź królowej"

#: solarui/garden/cast.lua
msgid "European robin"
msgstr "Rudzik"

#: solarui/garden/cast.lua
msgid "worms and seeds"
msgstr "dżdżownice i nasiona"

#: solarui/garden/cast.lua
msgid "Emperor dragonfly"
msgstr "Husarz władca"

#: solarui/garden/cast.lua
