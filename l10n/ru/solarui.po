msgstr[0] "%d книга проиндексирована; пересоберите после копирования книг"
msgstr[1] "%d книги проиндексированы; пересоберите после копирования книг"
msgstr[2] "%d книг проиндексировано; пересоберите после копирования книг"

#: solarui/screens/settings.lua
msgid "Rebuild"
msgstr "Пересобрать"

#: solarui/screens/settings.lua
msgid "%d book indexed"
msgid_plural "%d books indexed"
msgstr[0] "%d книга проиндексирована"
msgstr[1] "%d книги проиндексированы"
msgstr[2] "%d книг проиндексировано"

#: solarui/screens/settings.lua
msgid "How SolarUI stays fast"
msgstr "Как SolarUI остаётся быстрым"

#: solarui/screens/settings.lua
msgid "Home stays loaded while you read, so closing a book is a redraw, not a rebuild. The artwork is drawn once and kept, and the screen is refreshed only where it changed."
msgstr "Главная остаётся загруженной, пока вы читаете, поэтому закрытие книги — это перерисовка, а не пересборка. Рисунки рисуются один раз и сохраняются, а экран обновляется только там, где что-то изменилось."

#: solarui/screens/settings.lua
msgid "Support"
msgstr "Поддержка"

#: solarui/screens/settings.lua
msgid "SolarUI is free and made by one person. If it makes your reading better, a coffee helps keep it going."
msgstr "SolarUI бесплатен, его делает один человек. Если он делает чтение приятнее, чашка кофе поможет ему жить дальше."

#: solarui/screens/settings.lua
